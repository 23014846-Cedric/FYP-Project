<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Contact Queries • Card Delivery Portal</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        /* PAGE BACKGROUND */
        body {
            background: #f8fafc;   /* soft white */
            color: #1e293b;
            min-height: 100vh;
        }

        /* BLUE CARD CONTAINER */
        .blue-card {
            background: linear-gradient(to bottom right, #0d6efd, #4dabf7);
            border-radius: 1.25rem;
            padding: 2rem;
            color: white;
            box-shadow: 0 20px 50px rgba(0,0,0,0.15);
        }

        .page-title {
            font-weight: 700;
            font-size: 1.6rem;
            letter-spacing: .02em;
        }

        .subtext {
            font-size: 0.9rem;
            opacity: 0.95;
        }

        /* TABLE STYLE */
        .table-wrapper {
            background: white;
            border-radius: 0.9rem;
            padding: 1rem;
            border: 1px solid #e2e8f0;
        }

        thead {
            background: #f1f5f9;
            color: #475569;
            font-size: .85rem;
        }

        tbody tr {
            transition: background 0.15s ease;
        }

        tbody tr:hover {
            background: #e8f1ff;
        }

        .message-preview {
            max-width: 300px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            color: #475569;
        }

        /* STATUS BADGES */
        .status-badge {
            padding: 0.25rem .7rem;
            border-radius: 30px;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: capitalize;
        }

        .status-new {
            background: #dcfce7;
            color: #15803d;
        }

        .status-in_progress {
            background: #fef9c3;
            color: #b45309;
        }

        .status-closed {
            background: #fee2e2;
            color: #b91c1c;
        }
    </style>
</head>

<body>

    <%- include("partials/navbar") %>
    <div class="sidebar-hover-zone"></div>
    <%- include("partials/sidebar") %>

    <div class="container py-5">

        <!-- BLUE HEADER CARD -->
        <div class="blue-card mb-4">
            <h1 class="page-title mb-1">Contact Form Submissions</h1>
            <p class="subtext">Operations can review incoming enquiries submitted via the portal.</p>
        </div>

        <% if (!messages || messages.length === 0) { %>
            <div class="alert alert-info mt-4">
                There are no enquiries at the moment.
            </div>
        <% } else { %>

        <!-- WHITE TABLE CARD -->
        <div class="table-wrapper">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Company</th>
                            <th>Topic</th>
                            <th>Message</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>
                        <% messages.forEach(msg => { %>
                            <tr>
                                <td><%= new Date(msg.createdAt).toLocaleString("en-SG") %></td>
                                <td><%= msg.name %></td>
                                <td><%= msg.email %></td>
                                <td><%= msg.company || "-" %></td>
                                <td><%= msg.topic || "-" %></td>

                                <td class="message-preview" title="<%= msg.message %>">
                                    <%= msg.message %>
                                </td>

                                <td>
                                    <span class="status-badge status-<%= msg.status %>">
                                        <%= msg.status.replace("_", " ") %>
                                    </span>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>

                </table>
            </div>
        </div>

        <% } %>

    </div>

</body>
</html>
