<!-- views/contactMessages.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Contact Queries • Card Delivery Portal</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    body { background:#f8fafc; color:#1e293b; min-height:100vh; }

    .blue-card{
      background:linear-gradient(to bottom right,#0d6efd,#4dabf7);
      border-radius:1.25rem;
      padding:2rem;
      color:white;
      box-shadow:0 20px 50px rgba(0,0,0,0.15);
    }

    .page-title{ font-weight:700; font-size:1.6rem; letter-spacing:.02em; }
    .subtext{ font-size:.9rem; opacity:.95; }

    .table-wrapper{
      background:white;
      border-radius:.9rem;
      padding:1rem;
      border:1px solid #e2e8f0;
    }

    thead{ background:#f1f5f9; color:#475569; font-size:.85rem; }

    tbody tr{ transition:background .15s ease; }
    tbody tr:hover{ background:#e8f1ff; }

    .message-preview{
      max-width:300px;
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
      color:#475569;
    }

    .status-badge{
      padding:0.25rem .7rem;
      border-radius:30px;
      font-size:0.75rem;
      font-weight:600;
      text-transform:capitalize;
      border:none;
      cursor:pointer;
      display:inline-block;
    }

    .status-new{ background:#dcfce7; color:#15803d; }
    .status-in_progress{ background:#fef9c3; color:#b45309; }
    .status-closed{ background:#fee2e2; color:#b91c1c; }

    .inline-form{ display:inline-block; margin:0; }
  </style>
</head>

<body>

  <%- include("partials/navbar") %>
  <div class="sidebar-hover-zone"></div>
  <%- include("partials/sidebar") %>

  <div class="container py-5">

    <div class="blue-card mb-4">
      <h1 class="page-title mb-1">Contact Form Submissions</h1>
      <p class="subtext">Operations can review incoming enquiries submitted via the portal.</p>
    </div>

    <% if (!messages || messages.length === 0) { %>
      <div class="alert alert-info mt-4">There are no enquiries at the moment.</div>
    <% } else { %>

      <div class="table-wrapper">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">

            <thead>
              <tr>
                <th>Date</th>
                <th>Name</th>
                <th>Email</th>
                <th>Company</th>
                <th>Topic</th>
                <th>Message</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>

            <tbody>
              <% messages.forEach(msg => { %>
                <tr>
                  <td><%= new Date(msg.createdAt).toLocaleString("en-SG") %></td>
                  <td><%= msg.name %></td>
                  <td><%= msg.email %></td>
                  <td><%= msg.company || "-" %></td>
                  <td><%= msg.topic || "-" %></td>

                  <td class="message-preview" title="<%= msg.message %>">
                    <%= msg.message %>
                  </td>

                  <!-- Toggle Open/Closed -->
                  <td>
                    <form class="inline-form"
                          action="/contact/messages/<%= msg._id %>/toggle"
                          method="POST">
                      <button type="submit"
                        class="status-badge <%= (msg.status === 'closed') ? 'status-closed' : 'status-new' %>">
                        <%= (msg.status === 'closed') ? 'Closed' : 'Open' %>
                      </button>
                    </form>
                  </td>

                  <!-- Delete -->
                  <td class="text-end">
                    <form class="inline-form"
                          action="/contact/messages/<%= msg._id %>/delete"
                          method="POST"
                          onsubmit="return confirm('Delete this enquiry?');">
                      <button type="submit" class="btn btn-sm btn-outline-danger">
                        Delete
                      </button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>

          </table>
        </div>
      </div>

    <% } %>

  </div>

</body>
</html>
