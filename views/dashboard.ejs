<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Dashboard</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    body { background: linear-gradient(to right, #0d6efd, #4dabf7); min-height: 100vh; overflow-x: hidden; }

    .content-container { margin-left: 240px; padding: 40px 24px; min-height: 100vh; }
    @media (max-width: 992px) { .content-container { margin-left: 0; padding: 28px 16px; } }

    .card-box {
      background: white; border-radius: 12px; padding: 20px;
      box-shadow: 0 2px 12px rgba(0,0,0,0.15);
      transition: transform 0.15s ease;
    }
    .card-box:hover { transform: translateY(-4px); }

    .table th { white-space: nowrap; }

    .status-card {
      background: rgba(255,255,255,0.95);
      border: 1px solid rgba(15,23,42,0.08);
      border-radius: 16px;
      padding: 18px 18px 16px;
      box-shadow: 0 10px 24px rgba(0,0,0,0.08);
      transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
      position: relative;
      overflow: hidden;
    }
    .status-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 16px 36px rgba(0,0,0,0.14);
      border-color: rgba(13,110,253,0.25);
    }

    .status-topbar { position: absolute; top: 0; left: 0; height: 6px; width: 100%; opacity: 0.9; }
    .status-name { font-size: 0.92rem; font-weight: 700; color: #0f172a; margin: 2px 0 10px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .status-count { font-size: 2.15rem; font-weight: 900; line-height: 1; color: #0f172a; margin: 0; }
    .status-meta { margin-top: 10px; font-size: 0.82rem; color: rgba(15,23,42,0.55); display: flex; justify-content: space-between; align-items: center; }
    .status-pill { font-size: 0.72rem; font-weight: 700; padding: 6px 10px; border-radius: 999px; background: rgba(13,110,253,0.08); color: rgba(13,110,253,1); border: 1px solid rgba(13,110,253,0.18); }
  </style>
</head>

<body>
  <%- include("partials/navbar") %>
  <div class="sidebar-hover-zone"></div>
  <%- include("partials/sidebar") %>

  <main class="content-container">

    <div class="text-white mb-4">
      <h2 class="mb-1">Welcome, <%= user ? user.name : "Guest" %></h2>
      <small class="opacity-75">Role: <strong><%= user ? user.role : "N/A" %></strong></small>
    </div>

    <div class="row g-3">
      <%
        const colorMap = {
          "Delivered": "linear-gradient(90deg, #198754, #20c997)",
          "PENDING": "linear-gradient(90deg, #0d6efd, #4dabf7)",
          "IN TRANSIT": "linear-gradient(90deg, #0dcaf0, #66d9e8)",
          "RETURNED": "linear-gradient(90deg, #6c757d, #adb5bd)",
          "FAILED": "linear-gradient(90deg, #dc3545, #ff6b6b)",

          "Bad Address": "linear-gradient(90deg, #fd7e14, #ffc107)",
          "Consignee Not Around": "linear-gradient(90deg, #fd7e14, #ffc107)",
          "Denied Entry/Access": "linear-gradient(90deg, #fd7e14, #ffc107)",
          "Flooded Area": "linear-gradient(90deg, #fd7e14, #ffc107)",
          "Office Close": "linear-gradient(90deg, #fd7e14, #ffc107)",
          "Relocated": "linear-gradient(90deg, #fd7e14, #ffc107)",
          "Refuse to Accept": "linear-gradient(90deg, #fd7e14, #ffc107)",
          "Transfer": "linear-gradient(90deg, #6f42c1, #b197fc)",
          "Unlocated": "linear-gradient(90deg, #6f42c1, #b197fc)",
          "Return to Centre": "linear-gradient(90deg, #6c757d, #adb5bd)",
          "Return to Sender": "linear-gradient(90deg, #6c757d, #adb5bd)",
          "No Updates": "linear-gradient(90deg, #495057, #adb5bd)",
        };
      %>

      <% (statusList || []).forEach(s => {
        const count = (statsByStatus && statsByStatus[s]) ? statsByStatus[s] : 0;
        const bar = colorMap[s] || "linear-gradient(90deg, #0d6efd, #4dabf7)";
      %>
        <div class="col-12 col-sm-6 col-lg-3">
          <a href="/deliveries/overview" class="text-decoration-none">
            <div class="status-card h-100">
              <div class="status-topbar" style="background:<%= bar %>"></div>

              <div class="d-flex align-items-start justify-content-between gap-2">
                <div class="status-name" title="<%= s %>"><%= s %></div>
              </div>

              <p class="status-count"><%= count %></p>

              <div class="status-meta">
                <span class="text-nowrap">Records</span>
                <span class="text-nowrap">→</span>
              </div>
            </div>
          </a>
        </div>
      <% }) %>
    </div>

    <div class="row g-3 mt-4">
      <div class="col-12 col-lg-6">
        <div class="card-box">
          <h5 class="mb-3">Delivery Completion Overview</h5>
          <canvas id="pieIncompleteChart" height="200"></canvas>
        </div>
      </div>

      <div class="col-12 col-lg-6">
        <div class="card-box">
          <h5 class="mb-3">Delivery Status Breakdown</h5>
          <canvas id="barStatusChart" height="200"></canvas>
        </div>
      </div>
    </div>

    <!-- Delivery Records segment removed completely -->

  </main>

  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    const stats = <%- JSON.stringify(stats || { total: 0, delivered: 0, inTransit: 0, exceptions: 0 }) %>;
    const total = stats.total || 0;
    const delivered = stats.delivered || 0;
    const inTransit = stats.inTransit || 0;
    const exceptions = stats.exceptions || 0;
    const incomplete = Math.max(total - delivered, 0);

    if (total > 0) {
      const pieCtx = document.getElementById('pieIncompleteChart').getContext('2d');
      new Chart(pieCtx, {
        type: 'pie',
        data: { labels: ['Delivered', 'Not Delivered'], datasets: [{ data: [delivered, incomplete] }] },
        options: { plugins: { legend: { position: 'bottom' } } }
      });

      const barCtx = document.getElementById('barStatusChart').getContext('2d');
      new Chart(barCtx, {
        type: 'bar',
        data: {
          labels: ['Delivered', 'IN TRANSIT', 'FAILED+RETURNED'],
          datasets: [{ label: 'Number of Deliveries', data: [delivered, inTransit, exceptions] }]
        },
        options: {
          scales: { y: { beginAtZero: true, ticks: { precision: 0 } } },
          plugins: { legend: { display: false } }
        }
      });
    }
  </script>

  <%- include('partials/footer') %>
</body>
</html>
