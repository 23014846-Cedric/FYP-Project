<!DOCTYPE html>
<html>
<head>
  <title>Card Delivery – Courier</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>

<body class="p-4">
  <%- include("partials/navbar") %>
  <div class="sidebar-hover-zone"></div>
  <%- include("partials/sidebar") %>

  <div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h1>Courier – My Imported Deliveries</h1>
  </div>

  <!-- Import Card -->
  <div class="card mb-4">
    <div class="card-header fw-bold">
      Import Deliveries via Excel (.xlsx / .csv)
    </div>

    <div class="card-body">
      <form action="/courier/deliveries/import" method="POST" enctype="multipart/form-data">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label">Upload Excel File</label>
            <input type="file" name="excel_file" accept=".xlsx, .xls, .csv" class="form-control" required>
          </div>

          <div class="col-md-3 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">Import</button>
          </div>

          <div class="col-md-3 d-flex align-items-end">
            <a href="/wip" class="btn btn-outline-secondary w-100">Download Template</a>
          </div>
        </div>
      </form>

      <div class="mt-3 text-muted small">
        * This page only shows deliveries from your <b>latest import in this session</b>.
      </div>
    </div>
  </div>

  <% if (batchId) { %>
    <div class="alert alert-info">
      Viewing import batch: <code><%= batchId %></code>
    </div>
  <% } %>

  <!-- Filters -->
  <div class="card mb-3">
    <div class="card-body">
      <div class="row g-2 align-items-end">
        <div class="col-md-6">
          <label class="form-label">Search</label>
          <input id="searchInput" class="form-control" placeholder="Search card, recipient, address, courier">
        </div>

        <div class="col-md-3">
          <label class="form-label">Rows</label>
          <select id="rowsPerPage" class="form-select">
            <option value="10">10</option>
            <option value="25" selected>25</option>
            <option value="50">50</option>
            <option value="100">100</option>
          </select>
        </div>

        <div class="col-md-3 text-end">
          <span id="deliveryCount" class="text-muted"></span>
        </div>
      </div>
    </div>
  </div>

  <% if (!deliveries || deliveries.length === 0) { %>
    <div class="alert alert-warning">
      No deliveries to show yet for this session. Please import an Excel file.
    </div>
  <% } else { %>

    <table class="table table-bordered table-striped align-middle">
      <thead class="table-dark">
        <tr>
          <th>ID</th>
          <th>Card / Ref #</th>
          <th>Recipient</th>
          <th>Address</th>
          <th>Courier</th>
          <th>Status</th>
          <th>Updated At</th>
        </tr>
      </thead>

      <tbody>
        <% deliveries.forEach(d => { %>
          <tr>
            <td><%= d._id %></td>
            <td><%= d.card_number %></td>
            <td><%= d.recipient_name %></td>
            <td>
                <div class="fw-normal"><%= d.address %></div>

                <div class="d-flex gap-2 flex-wrap mt-2">
                    <a
                    class="btn btn-sm btn-outline-secondary"
                    target="_blank"
                    rel="noopener noreferrer"
                    href="https://www.google.com/maps/dir/?api=1&destination=<%= encodeURIComponent(d.address) %>"
                    >
                    Open Route
                    </a>

                    <button
                    type="button"
                    class="btn btn-sm btn-outline-primary copy-btn"
                    data-address="<%- (d.address || '').replace(/"/g, '&quot;') %>"
                    >
                    Copy Address
                    </button>
                </div>
            </td>
            <td><%= d.courier || '-' %></td>
            <td><span class="badge bg-info"><%= d.status %></span></td>
            <td>
              <%
                const dt = d.updated_at ? new Date(d.updated_at) : null;
              %>
              <%= dt ? dt.toISOString().slice(0,19).replace('T',' ') : '-' %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <!-- Pagination -->
    <nav class="d-flex justify-content-center mt-3">
      <ul class="pagination pagination-sm">
        <li class="page-item">
          <button id="prevPage" class="page-link">Prev</button>
        </li>
        <li class="page-item disabled">
          <span id="pageInfo" class="page-link"></span>
        </li>
        <li class="page-item">
          <button id="nextPage" class="page-link">Next</button>
        </li>
      </ul>
    </nav>

  <% } %>

  <%- include('partials/footer') %>

<script>
(() => {
  const tableBody = document.querySelector("tbody");
  if (!tableBody) return;

  const rows = Array.from(tableBody.querySelectorAll("tr"));
  const searchInput = document.getElementById("searchInput");
  const rowsPerPageSelect = document.getElementById("rowsPerPage");
  const pageInfo = document.getElementById("pageInfo");
  const prevBtn = document.getElementById("prevPage");
  const nextBtn = document.getElementById("nextPage");
  const deliveryCount = document.getElementById("deliveryCount");

  // Exit if required elements are missing
  if (!searchInput || !rowsPerPageSelect || !pageInfo || !prevBtn || !nextBtn || !deliveryCount) {
    console.warn("[Courier Search] Missing required elements");
    return;
  }

  let currentPage = 1;
  let rowsPerPage = parseInt(rowsPerPageSelect.value, 10);

  function getFilteredRows() {
    const search = (searchInput.value || "").toLowerCase();
    return rows.filter(row => row.innerText.toLowerCase().includes(search));
  }

  document.addEventListener("click", async (e) => {
    const btn = e.target.closest(".copy-btn");
    if (!btn) return;

    const address = btn.dataset.address || "";
    if (!address) return;

    try {
        await navigator.clipboard.writeText(address);
        const old = btn.textContent;
        btn.textContent = "Copied!";
        btn.classList.remove("btn-outline-primary");
        btn.classList.add("btn-success");

        setTimeout(() => {
        btn.textContent = old;
        btn.classList.remove("btn-success");
        btn.classList.add("btn-outline-primary");
        }, 1200);
    } catch (err) {
        alert("Copy failed — please copy manually:\n\n" + address);
    }
    });
    
  function render() {
    const filtered = getFilteredRows();
    const totalPages = Math.max(1, Math.ceil(filtered.length / rowsPerPage));
    currentPage = Math.min(currentPage, totalPages);

    rows.forEach(r => r.style.display = "none");

    const start = (currentPage - 1) * rowsPerPage;
    const end = start + rowsPerPage;
    filtered.slice(start, end).forEach(r => (r.style.display = ""));

    pageInfo.textContent = `Page ${currentPage} of ${totalPages}`;
    deliveryCount.textContent = `Showing ${filtered.length} deliveries`;

    prevBtn.disabled = currentPage === 1;
    nextBtn.disabled = currentPage === totalPages;
  }

  if (searchInput) searchInput.addEventListener("input", () => { currentPage = 1; render(); });
  if (rowsPerPageSelect) rowsPerPageSelect.addEventListener("change", () => {
    rowsPerPage = parseInt(rowsPerPageSelect.value, 10);
    currentPage = 1;
    render();
  });
  if (prevBtn) prevBtn.addEventListener("click", () => { if (currentPage > 1) { currentPage--; render(); } });
  if (nextBtn) nextBtn.addEventListener("click", () => { currentPage++; render(); });

  render();
})();
</script>

</body>
</html>
