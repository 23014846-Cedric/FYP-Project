<!DOCTYPE html>
<html>
<head>
  <title>Card Delivery – RTS Unprocess</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>

<body class="p-4">
  <%- include("../partials/navbar") %>
  <div class="sidebar-hover-zone"></div>
  <%- include("../partials/sidebar") %>
  <br>
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>RTS Unprocess Report</h1>

    <!-- Optional: Clear current session import -->
    <form method="POST" action="/deliveries/rts/clear-session" class="m-0">
      <button class="btn btn-outline-danger btn-sm" type="submit">
        Clear Session
      </button>
    </form>
  </div>
  <br>
  
  <!-- Excel Import Card -->
  <div class="card mb-4">
    <div class="card-header fw-bold">
      Import RTS Unprocess Report (.xlsx / .csv)
    </div>

    <div class="card-body">
      <form action="/deliveries/rts/import" method="POST" enctype="multipart/form-data" id="importForm" onsubmit="return confirmImport(event)">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label">Upload RTS Excel File</label>
            <input type="file" name="excel_file" accept=".xlsx, .xls, .csv" class="form-control" required id="excelFileInput">
          </div>

          <div class="col-md-3 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">
              Import
            </button>
          </div>

          <div class="col-md-3 d-flex align-items-end">
            <a href="/deliveries/rts/export<%= batchId ? '?batchId=' + encodeURIComponent(batchId) : '' %>" class="btn btn-outline-secondary w-100">
              Download Data
            </a>
          </div>
        </div>
      </form>
    </div>
  </div>
  <% if (typeof batchId !== 'undefined' && batchId) { %>
    <div class="alert alert-info">
      Viewing import batch: <code><%= batchId %></code>
    </div>
  <% } %>

  <!-- Filters & Controls -->
    <div class="card mb-3">
      <div class="card-body">
        <div class="row g-2 align-items-end">

          <div class="col-md-4">
            <label class="form-label">Search</label>
            <input id="searchInput" class="form-control" placeholder="Search AWB, recipient, address, courier">
          </div>

          <div class="col-md-3">
            <label class="form-label">Status</label>
            <select id="statusFilter" class="form-select">
              <option value="">All</option>
              <option>Bad Address</option>
              <option>Consignee Not Around</option>
              <option>Denied Entry/Access</option>
              <option>Flooded Area</option>
              <option>Office Close</option>
              <option>Relocated</option>
              <option>Refuse to Accept</option>
              <option>Transfer</option>
              <option>Unlocated</option>
            </select>
          </div>

          <div class="col-md-2">
            <label class="form-label">Rows</label>
            <select id="rowsPerPage" class="form-select">
              <option value="10">10</option>
              <option value="25" selected>25</option>
              <option value="50">50</option>
              <option value="100">100</option>
            </select>
          </div>

          <div class="col-md-3 text-end">
            <span id="deliveryCount" class="text-muted"></span>
          </div>

        </div>
      </div>
    </div>

  <!-- If no deliveries (no import in this session yet) -->
  <% if (!deliveries || deliveries.length === 0) { %>
    <div class="alert alert-warning">
      No RTS deliveries to show yet for this session. Please import an RTS Excel file.
    </div>
  <% } else { %>

    <!-- Deliveries Table -->
    <table class="table table-bordered table-striped align-middle table-sm">
      <thead class="table-dark">
        <tr>
          <th>Shipper Name</th>
          <th>Pickup Date</th>
          <th>Code</th>
          <th>RTS AWB</th>
          <th>Consignee Name</th>
          <th>Address</th>
          <th>Consignee ZIP</th>
          <th>Dest Port</th>
          <th>Date Received</th>
          <th>Reason</th>
          <th>Remarks</th>
          <th>Contact No</th>
          <th>Reference</th>
          <th>Status</th>
          <th>Action</th>
        </tr>
      </thead>

      <tbody>
        <% deliveries.forEach(d => { %>
          <tr>
            <td><%= d.ship_name || 'nil' %></td>
            <td><%= d.pickup_date || 'nil' %></td>
            <td><%= d.code || 'nil' %></td>
            <td><%= d.rts_awb || 'nil' %></td>
            <td><%= d.cnee_name || 'nil' %></td>
            <td><%= d.cnee_street || 'nil' %></td>
            <td><%= d.cnee_zip || 'nil' %></td>
            <td><%= d.dest_port || 'nil' %></td>
            <td><%= d.date_received || 'nil' %></td>
            <td><%= d.reason || 'nil' %></td>
            <td><%= d.remarks || 'nil' %></td>
            <td><%= d.cnee_contact_no || 'nil' %></td>
            <td><%= d.reference || 'nil' %></td>

            <td>
              <span class="badge bg-warning text-dark">
                <%= d.status %>
              </span>
            </td>

            <td>
              <form method="POST" action="/deliveries/<%= d.id %>/status" class="d-flex gap-1">
                <input type="hidden" name="batchId" value="<%= batchId || '' %>">
                <select name="status" class="form-select form-select-sm">
                  <option value="Bad Address"         <%= d.status === 'Bad Address' ? 'selected' : '' %>>Bad Address</option>
                  <option value="Consignee Not Around" <%= d.status === 'Consignee Not Around' ? 'selected' : '' %>>Consignee Not Around</option>
                  <option value="Denied Entry/Access"  <%= d.status === 'Denied Entry/Access' ? 'selected' : '' %>>Denied Entry/Access</option>
                  <option value="Flooded Area"        <%= d.status === 'Flooded Area' ? 'selected' : '' %>>Flooded Area</option>
                  <option value="Office Close"        <%= d.status === 'Office Close' ? 'selected' : '' %>>Office Close</option>
                  <option value="Relocated"           <%= d.status === 'Relocated' ? 'selected' : '' %>>Relocated</option>
                  <option value="Refuse to Accept"    <%= d.status === 'Refuse to Accept' ? 'selected' : '' %>>Refuse to Accept</option>
                  <option value="Transfer"            <%= d.status === 'Transfer' ? 'selected' : '' %>>Transfer</option>
                  <option value="Unlocated"           <%= d.status === 'Unlocated' ? 'selected' : '' %>>Unlocated</option>
                </select>

                <button type="submit" class="btn btn-sm btn-primary">Save</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>

  <!-- Pagination -->
  <nav class="d-flex justify-content-center mt-3">
    <ul class="pagination pagination-sm">
      <li class="page-item">
        <button id="prevPage" class="page-link">Prev</button>
      </li>
      <li class="page-item disabled">
        <span id="pageInfo" class="page-link"></span>
      </li>
      <li class="page-item">
        <button id="nextPage" class="page-link">Next</button>
      </li>
    </ul>
  </nav>

  <% } %>

  <%- include('../partials/footer') %>

<script>
(() => {
  const tableBody = document.querySelector("tbody");
  if (!tableBody) return;

  const rows = Array.from(tableBody.querySelectorAll("tr"));

  const searchInput = document.getElementById("searchInput");
  const statusFilter = document.getElementById("statusFilter");
  const rowsPerPageSelect = document.getElementById("rowsPerPage");
  const pageInfo = document.getElementById("pageInfo");
  const prevBtn = document.getElementById("prevPage");
  const nextBtn = document.getElementById("nextPage");
  const deliveryCount = document.getElementById("deliveryCount");

  let currentPage = 1;
  let rowsPerPage = parseInt(rowsPerPageSelect.value);

  function getFilteredRows() {
    const search = (searchInput.value || "").toLowerCase();
    const status = statusFilter.value;

    return rows.filter(row => {
      const text = row.innerText.toLowerCase();
      const rowStatus = row.children[5]?.innerText.trim();

      if (search && !text.includes(search)) return false;
      if (status && rowStatus !== status) return false;
      return true;
    });
  }

  function render() {
    const filtered = getFilteredRows();
    const totalPages = Math.max(1, Math.ceil(filtered.length / rowsPerPage));
    currentPage = Math.min(currentPage, totalPages);

    rows.forEach(r => r.style.display = "none");

    const start = (currentPage - 1) * rowsPerPage;
    const end = start + rowsPerPage;

    filtered.slice(start, end).forEach(r => (r.style.display = ""));

    pageInfo.textContent = `Page ${currentPage} of ${totalPages}`;
    deliveryCount.textContent = `Showing ${filtered.length} RTS deliveries`;

    prevBtn.disabled = currentPage === 1;
    nextBtn.disabled = currentPage === totalPages;
  }

  searchInput.addEventListener("input", () => { currentPage = 1; render(); });
  statusFilter.addEventListener("change", () => { currentPage = 1; render(); });
  rowsPerPageSelect.addEventListener("change", () => {
    rowsPerPage = parseInt(rowsPerPageSelect.value);
    currentPage = 1;
    render();
  });
  prevBtn.addEventListener("click", () => { if (currentPage > 1) { currentPage--; render(); } });
  nextBtn.addEventListener("click", () => { currentPage++; render(); });

  render();
})();

// ✅ Confirmation dialog for Excel import
function confirmImport(event) {
  const fileInput = document.getElementById('excelFileInput');
  const fileName = fileInput.files[0]?.name || 'No file selected';
  
  const confirmed = confirm(
    `Are you sure you want to import the RTS file: "${fileName}"?\n\n` +
    `This will:\n` +
    `• Add new RTS delivery records\n` +
    `• Update status for existing records if changed\n` +
    `• Skip duplicate records with no changes\n\n` +
    `Click OK to proceed or Cancel to abort.`
  );
  
  if (!confirmed) {
    event.preventDefault();
    return false;
  }
  
  return true;
}
</script>


</body>
</html>
