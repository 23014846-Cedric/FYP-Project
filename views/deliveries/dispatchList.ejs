<!DOCTYPE html>
<html>
<head>
  <title>Card Delivery – Dispatch List</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>

<body class="p-4">
  <%- include("../partials/navbar") %>
  <div class="sidebar-hover-zone"></div>
  <%- include("../partials/sidebar") %>
  <br>
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Dispatch List</h1>

    <!-- Optional: Clear current session import -->
    <form method="POST" action="/deliveries/dispatchlist/clear-session" class="m-0">
      <button class="btn btn-outline-danger btn-sm" type="submit">
        Clear Session
      </button>
    </form>
  </div>
  <br>
  
  <!-- Excel Import Card -->
  <div class="card mb-4">
    <div class="card-header fw-bold">
      Import Dispatch List (.xlsx / .csv)
    </div>

    <div class="card-body">
      <form action="/deliveries/dispatchlist/import" method="POST" enctype="multipart/form-data" id="importForm" onsubmit="return confirmImport(event)">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label">Upload Dispatch List File</label>
            <input type="file" name="excel_file" accept=".xlsx, .xls, .csv" class="form-control" required id="excelFileInput">
          </div>

          <div class="col-md-3 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">
              Import
            </button>
          </div>

          <div class="col-md-3 d-flex align-items-end">
            <a href="/deliveries/dispatchlist/export<%= batchId ? '?batchId=' + encodeURIComponent(batchId) : '' %>" class="btn btn-outline-secondary w-100">
              Download Data
            </a>
          </div>
        </div>
      </form>
    </div>
  </div>
  <% if (typeof batchId !== 'undefined' && batchId) { %>
    <div class="alert alert-info">
      Viewing import batch: <code><%= batchId %></code>
    </div>
  <% } %>

  <!-- Filters & Controls -->
    <div class="card mb-3">
      <div class="card-body">
        <div class="row g-2 align-items-end">

          <div class="col-md-4">
            <label class="form-label">Search</label>
            <input id="searchInput" class="form-control" placeholder="Search name, address, reference, AWB">
          </div>

          <div class="col-md-2">
            <label class="form-label">Rows</label>
            <select id="rowsPerPage" class="form-select">
              <option value="10">10</option>
              <option value="25" selected>25</option>
              <option value="50">50</option>
              <option value="100">100</option>
            </select>
          </div>

          <div class="col-md-6 text-end">
            <span id="dispatchCount" class="text-muted"></span>
          </div>

        </div>
      </div>
    </div>

  <!-- If no dispatches (no import in this session yet) -->
  <% if (!dispatches || dispatches.length === 0) { %>
    <div class="alert alert-warning">
      No dispatch list records to show yet for this session. Please import a Dispatch List Excel file.
    </div>
  <% } else { %>

    <!-- Dispatch Table -->
    <table class="table table-bordered table-striped align-middle table-sm">
      <thead class="table-dark">
        <tr>
          <th>No</th>
          <th>Name</th>
          <th>PAN</th>
          <th>Address</th>
          <th>City</th>
          <th>State</th>
          <th>Country</th>
          <th>ZIP Code</th>
          <th>Mobile No</th>
          <th>Product</th>
          <th>Reference Number</th>
          <th>File Name</th>
          <th>AWB Number</th>
          <th>Dispatch Date</th>
          <th>Action</th>
        </tr>
      </thead>

      <tbody>
        <% dispatches.forEach(d => { %>
          <tr>
            <td><%= d.no || 'nil' %></td>
            <td><%= d.name || 'nil' %></td>
            <td><%= d.pan || 'nil' %></td>
            <td><%= d.address1 || '' %><%= d.address2 ? ' ' + d.address2 : '' %><%= d.address3 ? ' ' + d.address3 : '' %></td>
            <td><%= d.city || 'nil' %></td>
            <td><%= d.state || 'nil' %></td>
            <td><%= d.country || 'nil' %></td>
            <td><%= d.zipCode || 'nil' %></td>
            <td><%= d.mobileNo || 'nil' %></td>
            <td><%= d.product || 'nil' %></td>
            <td><%= d.referenceNumber || 'nil' %></td>
            <td><%= d.fileName || 'nil' %></td>
            <td><%= d.awbNumber || 'nil' %></td>
            <td><%= d.dispatchDate ? new Date(d.dispatchDate).toLocaleDateString() : 'nil' %></td>

            <td>
              <div class="d-flex gap-1">
                <form method="POST" action="/deliveries/<%= d.id %>/status" class="d-flex gap-1" style="flex: 1;">
                  <input type="hidden" name="batchId" value="<%= batchId || '' %>">
                  <select name="status" class="form-select form-select-sm">
                    <option value="">-- Select Status --</option>
                    <option value="Delivered"               <%= d.status === 'Delivered' ? 'selected' : '' %>>Delivered</option>
                    <option value="Bad Address"             <%= d.status === 'Bad Address' ? 'selected' : '' %>>Bad Address</option>
                    <option value="Consignee Not Around"    <%= d.status === 'Consignee Not Around' ? 'selected' : '' %>>Consignee Not Around</option>
                    <option value="Denied Entry/Access"     <%= d.status === 'Denied Entry/Access' ? 'selected' : '' %>>Denied Entry/Access</option>
                    <option value="Flooded Area"            <%= d.status === 'Flooded Area' ? 'selected' : '' %>>Flooded Area</option>
                    <option value="Office Close"            <%= d.status === 'Office Close' ? 'selected' : '' %>>Office Close</option>
                    <option value="Relocated"               <%= d.status === 'Relocated' ? 'selected' : '' %>>Relocated</option>
                    <option value="Refuse to Accept"        <%= d.status === 'Refuse to Accept' ? 'selected' : '' %>>Refuse to Accept</option>
                    <option value="Transfer"                <%= d.status === 'Transfer' ? 'selected' : '' %>>Transfer</option>
                    <option value="Unlocated"               <%= d.status === 'Unlocated' ? 'selected' : '' %>>Unlocated</option>
                  </select>

                  <button type="submit" class="btn btn-sm btn-primary">Save</button>
                </form>

                <form method="POST" action="/deliveries/dispatchlist/<%= d.id %>/delete" style="display: inline;" onsubmit="return confirmDelete('<%= d.name || 'Record' %>');">
                  <input type="hidden" name="batchId" value="<%= batchId || '' %>">
                  <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>

  <!-- Pagination -->
  <nav class="d-flex justify-content-center mt-3">
    <ul class="pagination pagination-sm">
      <li class="page-item">
        <button id="prevPage" class="page-link">Prev</button>
      </li>
      <li class="page-item disabled">
        <span id="pageInfo" class="page-link"></span>
      </li>
      <li class="page-item">
        <button id="nextPage" class="page-link">Next</button>
      </li>
    </ul>
  </nav>

  <% } %>

  <%- include('../partials/footer') %>

<script>
(() => {
  const tableBody = document.querySelector("tbody");
  if (!tableBody) return;

  const rows = Array.from(tableBody.querySelectorAll("tr"));

  const searchInput = document.getElementById("searchInput");
  const rowsPerPageSelect = document.getElementById("rowsPerPage");
  const pageInfo = document.getElementById("pageInfo");
  const prevBtn = document.getElementById("prevPage");
  const nextBtn = document.getElementById("nextPage");
  const dispatchCount = document.getElementById("dispatchCount");

  let currentPage = 1;
  let rowsPerPage = parseInt(rowsPerPageSelect.value);

  function getFilteredRows() {
    const search = (searchInput.value || "").toLowerCase();

    return rows.filter(row => {
      const text = row.innerText.toLowerCase();

      if (search && !text.includes(search)) return false;
      return true;
    });
  }

  function render() {
    const filtered = getFilteredRows();
    const totalPages = Math.max(1, Math.ceil(filtered.length / rowsPerPage));
    currentPage = Math.min(currentPage, totalPages);

    rows.forEach(r => r.style.display = "none");

    const start = (currentPage - 1) * rowsPerPage;
    const end = start + rowsPerPage;

    filtered.slice(start, end).forEach(r => (r.style.display = ""));

    pageInfo.textContent = `Page ${currentPage} of ${totalPages}`;
    dispatchCount.textContent = `Showing ${filtered.length} dispatch records`;

    prevBtn.disabled = currentPage === 1;
    nextBtn.disabled = currentPage === totalPages;
  }

  searchInput.addEventListener("input", () => { currentPage = 1; render(); });
  rowsPerPageSelect.addEventListener("change", () => {
    rowsPerPage = parseInt(rowsPerPageSelect.value);
    currentPage = 1;
    render();
  });
  prevBtn.addEventListener("click", () => { if (currentPage > 1) { currentPage--; render(); } });
  nextBtn.addEventListener("click", () => { currentPage++; render(); });

  render();
})();

// Confirmation dialog for Excel import
function confirmImport(event) {
  const fileInput = document.getElementById('excelFileInput');
  const fileName = fileInput.files[0]?.name || 'No file selected';
  
  const confirmed = confirm(
    `Are you sure you want to import the Dispatch List file: "${fileName}"?\n\n` +
    `This will:\n` +
    `• Add new dispatch list records\n` +
    `• Update records if they already exist\n` +
    `• Skip invalid records\n\n` +
    `Click OK to proceed or Cancel to abort.`
  );
  
  if (!confirmed) {
    event.preventDefault();
    return false;
  }
  
  return true;
}

// Confirmation dialog for deletion
function confirmDelete(recordName) {
  const confirmed = confirm(
    `WARNING: Delete Record\n\n` +
    `Are you sure you want to permanently delete this record?\n` +
    `Record: ${recordName}\n\n` +
    `This action CANNOT be undone.\n\n` +
    `Click OK to delete or Cancel to keep it.`
  );
  
  return confirmed;
}
</script>


</body>
</html>
