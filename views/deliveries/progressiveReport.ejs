<!DOCTYPE html>
<html>
<head>
  <title>Progressive Report</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>

<body class="p-4">
  <%- include("partials/navbar") %>
  <div class="sidebar-hover-zone"></div>
  <%- include("partials/sidebar") %>

  <br>
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Import Progressive Report</h1>

    <!-- ✅ UPDATED to match mount: /deliveries/progressivereports -->
    <form method="POST" action="/deliveries/progressivereports/clear-session" class="m-0">
      <button class="btn btn-outline-danger btn-sm" type="submit">Clear Session</button>
    </form>
  </div>

  <!-- Excel Import Card -->
  <div class="card mb-4">
    <div class="card-header fw-bold">
      Import Progressive Report via Excel (.xlsx / .csv)
    </div>
    <div class="card-body">
      <!-- ✅ UPDATED to match mount: /deliveries/progressivereports -->
      <form action="/deliveries/progressivereports/import" method="POST" enctype="multipart/form-data" onsubmit="return confirmImport(event)">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label">Upload Excel File</label>
            <input type="file" name="excel_file" accept=".xlsx,.xls,.csv" class="form-control" required id="excelFileInput">
          </div>

          <div class="col-md-3 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">Import</button>
          </div>

          <div class="col-md-3 d-flex align-items-end">
            <a href="/templates/progressive-template" class="btn btn-outline-secondary w-100">Download Template</a>
          </div>
        </div>
      </form>
    </div>
  </div>

  <% if (typeof batchId !== 'undefined' && batchId) { %>
    <div class="alert alert-info">Viewing import batch: <code><%= batchId %></code></div>
  <% } %>

  <!-- Filters -->
  <div class="card mb-3">
    <div class="card-body">
      <div class="row g-2 align-items-end">
        <div class="col-md-5">
          <label class="form-label">Search</label>
          <input id="searchInput" class="form-control" placeholder="Search name, ref, AWB, status, remarks, port">
        </div>

        <div class="col-md-3">
          <label class="form-label">Status</label>
          <select id="statusFilter" class="form-select">
            <option value="">All</option>
            <option>DELIVERED</option>
            <option>FAILED</option>
            <option>NOT FOUND</option>
            <option>PENDING</option>
          </select>
        </div>

        <div class="col-md-2">
          <label class="form-label">Rows</label>
          <select id="rowsPerPage" class="form-select">
            <option value="10">10</option>
            <option value="25" selected>25</option>
            <option value="50">50</option>
            <option value="100">100</option>
          </select>
        </div>

        <div class="col-md-2 text-end">
          <span id="countText" class="text-muted"></span>
        </div>
      </div>
    </div>
  </div>

  <% if (!reports || reports.length === 0) { %>
    <div class="alert alert-warning">
      No progressive report records to show yet for this session. Please import an Excel file.
    </div>
  <% } else { %>

    <table class="table table-bordered table-striped align-middle">
      <thead class="table-dark">
        <tr>
          <th>NUMBER</th>
          <th>NAME</th>
          <th>PAN</th>
          <th>ADDRESS1</th>
          <th>ADDRESS2</th>
          <th>ADDRESS3</th>
          <th>ADDRESS4</th>
          <th>ZIPCODE</th>
          <th>MOBILE NO.</th>
          <th>PRODUCT</th>
          <th>REFERENCE NUMBER</th>
          <th>FILE NAME</th>
          <th>AWB NUMBER</th>
          <th>DISPATCH DATE</th>
          <th>RECEIVED BY</th>
          <th>RECEIVED DATE</th>
          <th>STATUS</th>
          <th>REMARKS</th>
          <th>PORT</th>
        </tr>
      </thead>

      <tbody>
        <% reports.forEach((r, idx) => { %>
          <tr>
            <td><%= r.number ?? (idx + 1) %></td>
            <td><%= r.name || "" %></td>
            <td><%= r.pan || "" %></td>
            <td><%= r.address1 || "" %></td>
            <td><%= r.address2 || "" %></td>
            <td><%= r.address3 || "" %></td>
            <td><%= r.address4 || "" %></td>
            <td><%= r.zipCode || "" %></td>
            <td><%= r.mobileNo || "" %></td>
            <td><%= r.product || "" %></td>
            <td><%= r.referenceNumber || "" %></td>
            <td><%= r.fileName || "" %></td>
            <td><%= r.awbNumber || "" %></td>
            <td>
              <% const dd = r.dispatchDate ? new Date(r.dispatchDate) : null; %>
              <%= dd ? dd.toISOString().slice(0,10) : "" %>
            </td>
            <td><%= r.receivedBy || "" %></td>
            <td>
              <% const rd = r.receivedDate ? new Date(r.receivedDate) : null; %>
              <%= rd ? rd.toISOString().slice(0,10) : "" %>
            </td>
            <td><span class="badge bg-info"><%= r.status || "" %></span></td>
            <td><%= r.remarks || "" %></td>
            <td><%= r.port || "" %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <!-- Pagination -->
    <nav class="d-flex justify-content-center mt-3">
      <ul class="pagination pagination-sm">
        <li class="page-item"><button id="prevPage" class="page-link">Prev</button></li>
        <li class="page-item disabled"><span id="pageInfo" class="page-link"></span></li>
        <li class="page-item"><button id="nextPage" class="page-link">Next</button></li>
      </ul>
    </nav>

  <% } %>

  <%- include('partials/footer') %>

<script>
(() => {
  const tbody = document.querySelector("tbody");
  if (!tbody) return;

  const rows = Array.from(tbody.querySelectorAll("tr"));
  const searchInput = document.getElementById("searchInput");
  const statusFilter = document.getElementById("statusFilter");
  const rowsPerPageSelect = document.getElementById("rowsPerPage");
  const pageInfo = document.getElementById("pageInfo");
  const prevBtn = document.getElementById("prevPage");
  const nextBtn = document.getElementById("nextPage");
  const countText = document.getElementById("countText");

  let currentPage = 1;
  let rowsPerPage = parseInt(rowsPerPageSelect.value);

  function getFilteredRows() {
    const q = (searchInput.value || "").toLowerCase();
    const st = statusFilter.value;

    return rows.filter(r => {
      const text = r.innerText.toLowerCase();
      const rowStatus = r.children[16]?.innerText.trim(); // STATUS col
      if (q && !text.includes(q)) return false;
      if (st && rowStatus !== st) return false;
      return true;
    });
  }

  function render() {
    const filtered = getFilteredRows();
    const totalPages = Math.max(1, Math.ceil(filtered.length / rowsPerPage));
    currentPage = Math.min(currentPage, totalPages);

    rows.forEach(r => r.style.display = "none");
    const start = (currentPage - 1) * rowsPerPage;
    const end = start + rowsPerPage;
    filtered.slice(start, end).forEach(r => r.style.display = "");

    pageInfo.textContent = `Page ${currentPage} of ${totalPages}`;
    countText.textContent = `Showing ${filtered.length} records`;

    prevBtn.disabled = currentPage === 1;
    nextBtn.disabled = currentPage === totalPages;
  }

  searchInput?.addEventListener("input", () => { currentPage = 1; render(); });
  statusFilter?.addEventListener("change", () => { currentPage = 1; render(); });
  rowsPerPageSelect?.addEventListener("change", () => {
    rowsPerPage = parseInt(rowsPerPageSelect.value);
    currentPage = 1;
    render();
  });
  prevBtn?.addEventListener("click", () => { if (currentPage > 1) { currentPage--; render(); } });
  nextBtn?.addEventListener("click", () => { currentPage++; render(); });

  render();
})();

function confirmImport(event) {
  const fileInput = document.getElementById('excelFileInput');
  const fileName = fileInput.files[0]?.name || 'No file selected';
  const ok = confirm(
    `Import file: "${fileName}"?\n\n` +
    `This will parse rows and save them into the Progressive Report session + database.\n\n` +
    `OK to proceed, Cancel to stop.`
  );
  if (!ok) { event.preventDefault(); return false; }
  return true;
}
</script>
</body>
</html>
