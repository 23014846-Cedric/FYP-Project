<!DOCTYPE html>
<html>
<head>
  <title>Card Delivery – Progressive Report</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>

<body class="p-4">
  <%- include("../partials/navbar") %>
  <div class="sidebar-hover-zone"></div>
  <%- include("../partials/sidebar") %>
  <br>
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Progressive Report</h1>

    <!-- Optional: Clear current session import -->
    <form method="POST" action="/deliveries/progressivereports/clear-session" class="m-0">
      <button class="btn btn-outline-danger btn-sm" type="submit">
        Clear Session
      </button>
    </form>
  </div>
  <br>
  
  <!-- Excel Import Card -->
  <div class="card mb-4">
    <div class="card-header fw-bold">
      Import Progressive Report (.xlsx / .csv)
    </div>

    <div class="card-body">
      <form action="/deliveries/progressivereports/import" method="POST" enctype="multipart/form-data" id="importForm" onsubmit="return confirmImport(event)">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label">Upload Progressive Report File</label>
            <input type="file" name="excel_file" accept=".xlsx, .xls, .csv" class="form-control" required id="excelFileInput">
          </div>

          <div class="col-md-3 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">
              Import
            </button>
          </div>

          <div class="col-md-3 d-flex align-items-end">
            <a href="/deliveries/progressivereports/export<%= batchId ? '?batchId=' + encodeURIComponent(batchId) : '' %>" class="btn btn-outline-secondary w-100">
              Download Data
            </a>
          </div>
        </div>
      </form>
    </div>
  </div>
  <% if (typeof batchId !== 'undefined' && batchId) { %>
    <div class="alert alert-info">
      Viewing import batch: <code><%= batchId %></code>
    </div>
  <% } %>

  <!-- Filters & Controls -->
    <div class="card mb-3">
      <div class="card-body">
        <div class="row g-2 align-items-end">

          <div class="col-md-4">
            <label class="form-label">Search</label>
            <input id="searchInput" class="form-control" placeholder="Search AWB, name, address, reference">
          </div>

          <div class="col-md-3">
            <label class="form-label">Status</label>
            <select id="statusFilter" class="form-select">
              <option value="">All</option>
              <option>Delivered</option>
              <option>Bad Address</option>
              <option>Consignee Not Around</option>
              <option>Denied Entry/Access</option>
              <option>Flooded Area</option>
              <option>Office Close</option>
              <option>Relocated</option>
              <option>Refuse to Accept</option>
              <option>Transfer</option>
              <option>Unlocated</option>
              <option>Return to Centre</option>
              <option>Return to Sender</option>
            </select>
          </div>

          <div class="col-md-2">
            <label class="form-label">Rows</label>
            <select id="rowsPerPage" class="form-select">
              <option value="10">10</option>
              <option value="25" selected>25</option>
              <option value="50">50</option>
              <option value="100">100</option>
            </select>
          </div>

          <div class="col-md-3 text-end">
            <span id="reportCount" class="text-muted"></span>
          </div>

        </div>
      </div>
    </div>

  <!-- If no reports (no import in this session yet) -->
  <% if (!reports || reports.length === 0) { %>
    <div class="alert alert-warning">
      No progressive reports to show yet for this session. Please import a Progressive Report Excel file.
    </div>
  <% } else { %>

    <!-- Reports Table -->
    <table class="table table-bordered table-striped align-middle table-sm">
      <thead class="table-dark">
        <tr>
          <th>No</th>
          <th>Name</th>
          <th>PAN</th>
          <th>Address</th>
          <th>City</th>
          <th>State</th>
          <th>ZIP Code</th>
          <th>Mobile No</th>
          <th>AWB Number</th>
          <th>Reference Number</th>
          <th>File Name</th>
          <th>Dispatch Date</th>
          <th>Received By</th>
          <th>Received Date</th>
          <th>Port</th>
          <th>Status</th>
          <th>Remarks</th>
          <th>Action</th>
        </tr>
      </thead>

      <tbody>
        <% reports.forEach(r => { %>
          <tr>
            <td><%= r.number || 'nil' %></td>
            <td><%= r.name || 'nil' %></td>
            <td><%= r.pan || 'nil' %></td>
            <td><%= r.address1 || '' %><%= r.address2 ? ' ' + r.address2 : '' %><%= r.address3 ? ' ' + r.address3 : '' %></td>
            <td><%= r.city || 'nil' %></td>
            <td><%= r.state || 'nil' %></td>
            <td><%= r.zipCode || 'nil' %></td>
            <td><%= r.mobileNo || 'nil' %></td>
            <td><%= r.awbNumber || 'nil' %></td>
            <td><%= r.referenceNumber || 'nil' %></td>
            <td><%= r.fileName || 'nil' %></td>
            <td><%= r.dispatchDate ? new Date(r.dispatchDate).toLocaleDateString() : 'nil' %></td>
            <td><%= r.receivedBy || 'nil' %></td>
            <td><%= r.receivedDate ? new Date(r.receivedDate).toLocaleDateString() : 'nil' %></td>
            <td><%= r.port || 'nil' %></td>

            <td>
              <span class="badge bg-info text-dark">
                <%= r.status || 'No Status' %>
              </span>
            </td>

            <td><%= r.remarks || '-' %></td>

            <td>
              <form method="POST" action="/deliveries/<%= r.id %>/status" class="d-flex gap-1">
                <input type="hidden" name="batchId" value="<%= batchId || '' %>">
                <select name="status" class="form-select form-select-sm">
                  <option value="Delivered"               <%= r.status === 'Delivered' ? 'selected' : '' %>>Delivered</option>
                  <option value="Bad Address"             <%= r.status === 'Bad Address' ? 'selected' : '' %>>Bad Address</option>
                  <option value="Consignee Not Around"    <%= r.status === 'Consignee Not Around' ? 'selected' : '' %>>Consignee Not Around</option>
                  <option value="Denied Entry/Access"     <%= r.status === 'Denied Entry/Access' ? 'selected' : '' %>>Denied Entry/Access</option>
                  <option value="Flooded Area"            <%= r.status === 'Flooded Area' ? 'selected' : '' %>>Flooded Area</option>
                  <option value="Office Close"            <%= r.status === 'Office Close' ? 'selected' : '' %>>Office Close</option>
                  <option value="Relocated"               <%= r.status === 'Relocated' ? 'selected' : '' %>>Relocated</option>
                  <option value="Refuse to Accept"        <%= r.status === 'Refuse to Accept' ? 'selected' : '' %>>Refuse to Accept</option>
                  <option value="Transfer"                <%= r.status === 'Transfer' ? 'selected' : '' %>>Transfer</option>
                  <option value="Unlocated"               <%= r.status === 'Unlocated' ? 'selected' : '' %>>Unlocated</option>
                  <option value="Return to Centre"        <%= r.status === 'Return to Centre' ? 'selected' : '' %>>Return to Centre</option>
                  <option value="Return to Sender"        <%= r.status === 'Return to Sender' ? 'selected' : '' %>>Return to Sender</option>
                </select>

                <button type="submit" class="btn btn-sm btn-primary">Save</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>

  <!-- Pagination -->
  <nav class="d-flex justify-content-center mt-3">
    <ul class="pagination pagination-sm">
      <li class="page-item">
        <button id="prevPage" class="page-link">Prev</button>
      </li>
      <li class="page-item disabled">
        <span id="pageInfo" class="page-link"></span>
      </li>
      <li class="page-item">
        <button id="nextPage" class="page-link">Next</button>
      </li>
    </ul>
  </nav>

  <% } %>

  <%- include('../partials/footer') %>

<script>
(() => {
  const tableBody = document.querySelector("tbody");
  if (!tableBody) return;

  const rows = Array.from(tableBody.querySelectorAll("tr"));

  const searchInput = document.getElementById("searchInput");
  const statusFilter = document.getElementById("statusFilter");
  const rowsPerPageSelect = document.getElementById("rowsPerPage");
  const pageInfo = document.getElementById("pageInfo");
  const prevBtn = document.getElementById("prevPage");
  const nextBtn = document.getElementById("nextPage");
  const reportCount = document.getElementById("reportCount");

  let currentPage = 1;
  let rowsPerPage = parseInt(rowsPerPageSelect.value);

  function getFilteredRows() {
    const search = (searchInput.value || "").toLowerCase();
    const status = statusFilter.value;

    return rows.filter(row => {
      const text = row.innerText.toLowerCase();
      const rowStatus = row.children[15]?.innerText.trim();

      if (search && !text.includes(search)) return false;
      if (status && rowStatus !== status) return false;
      return true;
    });
  }

  function render() {
    const filtered = getFilteredRows();
    const totalPages = Math.max(1, Math.ceil(filtered.length / rowsPerPage));
    currentPage = Math.min(currentPage, totalPages);

    rows.forEach(r => r.style.display = "none");

    const start = (currentPage - 1) * rowsPerPage;
    const end = start + rowsPerPage;

    filtered.slice(start, end).forEach(r => (r.style.display = ""));

    pageInfo.textContent = `Page ${currentPage} of ${totalPages}`;
    reportCount.textContent = `Showing ${filtered.length} progressive reports`;

    prevBtn.disabled = currentPage === 1;
    nextBtn.disabled = currentPage === totalPages;
  }

  searchInput.addEventListener("input", () => { currentPage = 1; render(); });
  statusFilter.addEventListener("change", () => { currentPage = 1; render(); });
  rowsPerPageSelect.addEventListener("change", () => {
    rowsPerPage = parseInt(rowsPerPageSelect.value);
    currentPage = 1;
    render();
  });
  prevBtn.addEventListener("click", () => { if (currentPage > 1) { currentPage--; render(); } });
  nextBtn.addEventListener("click", () => { currentPage++; render(); });

  render();
})();

// Confirmation dialog for Excel import
function confirmImport(event) {
  const fileInput = document.getElementById('excelFileInput');
  const fileName = fileInput.files[0]?.name || 'No file selected';
  
  const confirmed = confirm(
    `Are you sure you want to import the Progressive Report file: "${fileName}"?\n\n` +
    `This will:\n` +
    `• Add new progressive report records\n` +
    `• Update status for existing records if changed\n` +
    `• Skip duplicate records with no changes\n\n` +
    `Click OK to proceed or Cancel to abort.`
  );
  
  if (!confirmed) {
    event.preventDefault();
    return false;
  }
  
  return true;
}
</script>


</body>
</html>
