<!DOCTYPE html>
<html>
<head>
  <title>Suspicious Activity Review</title>
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >
</head>

<body class="p-4">
  <%- include("partials/navbar") %>

  <div class="sidebar-hover-zone"></div>
  <%- include("partials/sidebar") %>

  <div class="container-fluid mt-4">
    <h2 class="mb-4">Suspicious Activity Review</h2>

    <form method="GET" action="/admin/review" class="row g-2 mb-3">
    <% const f = (typeof filters !== "undefined" && filters) ? filters : {}; %>
    <% const t = String(f.type || "all"); %>
    <% const ms = Number(f.minSeverity || 1); %>
    <% const lim = Number(f.limit || 200); %>

    <div class="col-auto">
      <label class="form-label mb-0 small text-muted">Type</label>
      <select name="type" class="form-select form-select-sm">
        <option value="all" <%= t==="all" ? "selected" : "" %>>All</option>
        <option value="burst" <%= t==="burst" ? "selected" : "" %>>Burst edits</option>
        <option value="auth" <%= t==="auth" ? "selected" : "" %>>Login/Logout burst</option>
        <option value="anchoring" <%= t==="anchoring" ? "selected" : "" %>>After anchoring</option>
        <option value="flipflop" <%= t==="flipflop" ? "selected" : "" %>>Status flip-flop</option>
        <option value="sensitive" <%= t==="sensitive" ? "selected" : "" %>>Sensitive edits</option>
        <option value="other" <%= t==="other" ? "selected" : "" %>>Other</option>
      </select>
    </div>

    <div class="col-auto">
      <label class="form-label mb-0 small text-muted">User</label>
      <input
        type="text"
        name="user"
        class="form-control form-control-sm"
        placeholder="e.g. admin"
        value="<%= f.user ? f.user : "" %>"
      />
    </div>

    <div class="col-auto">
      <label class="form-label mb-0 small text-muted">Min severity</label>
      <select name="minSeverity" class="form-select form-select-sm">
        <% [1,2,3,4,5].forEach(x => { %>
          <option value="<%= x %>" <%= ms === x ? "selected" : "" %>><%= x %>+</option>
        <% }) %>
      </select>
    </div>

    <div class="col-auto">
      <label class="form-label mb-0 small text-muted">Limit</label>
      <select name="limit" class="form-select form-select-sm">
        <% [100,200,300,500,1000].forEach(x => { %>
          <option value="<%= x %>" <%= lim === x ? "selected" : "" %>><%= x %></option>
        <% }) %>
      </select>
    </div>

    <div class="col-auto d-flex align-items-end">
      <button type="submit" class="btn btn-primary btn-sm">Apply</button>
      <a href="/admin/review" class="btn btn-outline-secondary btn-sm ms-2">Reset</a>
    </div>
  </form>


    <div class="d-flex align-items-center mb-3">
    <a href="/admin/review" class="btn btn-outline-primary btn-sm">
      Refresh
    </a>
  </div>


<table class="table table-striped">
  <thead>
    <tr>
      <th>Time</th>
      <th>User</th>
      <th>Action</th>
      <th>Entity</th>
      <th>Severity</th>
      <th>Reasons</th>
      <th>Case Notes</th>
    </tr>
  </thead>
  <tbody>

  <% if (!incidents || incidents.length === 0) { %>
    <tr>
      <td colspan="6" class="text-center text-muted">
        No suspicious activity detected.
      </td>
    </tr>
  <% } %>

  <% (incidents || []).forEach(item => { %>
    <tr>
      <td>
        <%= new Date(item.time)
          .toLocaleString("en-SG", { timeZone: "Asia/Singapore" }) %>
      </td>

      <td><strong><%= item.user || "System" %></strong></td>

      <td><%= item.suspiciousType || item.type || "Suspicious activity" %></td>

      <td><%= item.entitySummary || "-" %></td>

      <td>
        <span class="badge bg-danger"><%= item.severity || 1 %></span>
      </td>

      <td>
        <ul style="margin:0; padding-left:18px;">
          <% (item.reasons || []).forEach(r => { %>
            <li><%= r %></li>
          <% }) %>
        </ul>
      </td>

      <td style="min-width:300px">
        <% const notes = notesByIncident[item.incidentId] || []; %>

        <form method="POST" action="/admin/review/note" class="mb-2">
          <input type="hidden" name="incidentId" value="<%= item.incidentId %>">

          <select name="review_status" class="form-select form-select-sm mb-1">
            <option value="pending">pending</option>
            <option value="investigating">investigating</option>
            <option value="approved">approved</option>
          </select>

          <textarea
            name="review_comment"
            class="form-control form-control-sm mb-1"
            rows="2"
            placeholder="Add case note..."
          ></textarea>

          <button class="btn btn-sm btn-primary">Save</button>
        </form>

        <% notes.forEach(n => { %>
          <div class="border rounded p-2 mb-2 small">
            <div class="d-flex justify-content-between">
              <strong><%= n.review_status %></strong>
              <form method="POST" action="/admin/review/note/<%= n._id %>/delete">
                <button class="btn btn-sm btn-outline-danger">Delete</button>
              </form>
            </div>
            <div class="text-muted">
              <%= n.reviewed_by.username %> —
              <%= new Date(n.reviewed_at).toLocaleString("en-SG") %>
            </div>
            <div><%= n.review_comment %></div>
          </div>
        <% }) %>
      </td>
    </tr>
  <% }) %>

</tbody>

</table>
