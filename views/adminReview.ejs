<!DOCTYPE html>
<html>
<head>
  <title>Suspicious Activity Review</title>
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >
</head>

<body class="p-4">
  <%- include("partials/navbar") %>

  <div class="sidebar-hover-zone"></div>
  <%- include("partials/sidebar") %>

  <div class="container-fluid mt-4">
    <h2 class="mb-4">Suspicious Activity Review</h2>

    <div class="d-flex align-items-center mb-3">
    <a href="/admin/review" class="btn btn-outline-primary btn-sm">
      Refresh
    </a>
    <% if (typeof since !== "undefined") { %>
      <span class="text-muted ms-3">
        Showing recent activity since <%= since.toLocaleDateString("en-SG") %>
      </span>
    <% } %>
  </div>


<table class="table table-striped">
  <thead>
    <tr>
      <th>Time</th>
      <th>User</th>
      <th>Action</th>
      <th>Entity</th>
      <th>Severity</th>
      <th>Reasons</th>
    </tr>
  </thead>
  <tbody>

  <% if (!incidents || incidents.length === 0) { %>
    <tr>
      <td colspan="6" class="text-center text-muted">
        No suspicious activity detected.
      </td>
    </tr>
  <% } %>

  <% (incidents || []).forEach(item => { %>
    <tr>
      <td>
        <%= new Date(item.time)
          .toLocaleString("en-SG", { timeZone: "Asia/Singapore" }) %>
      </td>

      <td><strong><%= item.user || "System" %></strong></td>

      <td><%= item.suspiciousType || item.type || "Suspicious activity" %></td>

      <td><%= item.entitySummary || "-" %></td>

      <td>
        <span class="badge bg-danger"><%= item.severity || 1 %></span>
      </td>

      <td>
        <ul style="margin:0; padding-left:18px;">
          <% (item.reasons || []).forEach(r => { %>
            <li><%= r %></li>
          <% }) %>
        </ul>
      </td>
    </tr>
  <% }) %>

</tbody>

</table>
