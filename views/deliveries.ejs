<!DOCTYPE html>
<html>
<head>
  <title>Card Delivery – Deliveries</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>

<body class="p-4">
  <%- include("partials/navbar") %>
  <div class="sidebar-hover-zone"></div>
  <%- include("partials/sidebar") %>
  <br>
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Import Deliveries</h1>

    <!-- Optional: Clear current session import -->
    <form method="POST" action="/deliveries/clear-session" class="m-0">
      <button class="btn btn-outline-danger btn-sm" type="submit">
        Clear Session
      </button>
    </form>
  </div>
  <br>
  
  <!-- Excel Import Card -->
  <div class="card mb-4">
    <div class="card-header fw-bold">
      Import Deliveries via Excel (.xlsx / .csv)
    </div>

    <div class="card-body">
      <form action="/deliveries/import" method="POST" enctype="multipart/form-data">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label">Upload Excel File</label>
            <input type="file" name="excel_file" accept=".xlsx, .xls, .csv" class="form-control" required>
          </div>

          <div class="col-md-3 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">
              Import
            </button>
          </div>

          <div class="col-md-3 d-flex align-items-end">
            <a href="/wip" class="btn btn-outline-secondary w-100">
              Download Template
            </a>
          </div>
        </div>
      </form>
    </div>
  </div>
  <% if (typeof batchId !== 'undefined' && batchId) { %>
    <div class="alert alert-info">
      Viewing import batch: <code><%= batchId %></code>
    </div>
  <% } %>

  <!-- Filters & Controls -->
    <div class="card mb-3">
      <div class="card-body">
        <div class="row g-2 align-items-end">

          <div class="col-md-4">
            <label class="form-label">Search</label>
            <input id="searchInput" class="form-control" placeholder="Search card, recipient, address, courier">
          </div>

          <div class="col-md-3">
            <label class="form-label">Status</label>
            <select id="statusFilter" class="form-select">
              <option value="">All</option>
              <option>Pending</option>
              <option>Pulled Out</option>
              <option>Not Found</option>
              <option>Handed to Courier</option>
              <option>Delivered</option>
              <option>Returned to Printer</option>
              <option>Destroyed</option>
              <option>Reprocessing</option>
            </select>
          </div>

          <div class="col-md-2">
            <label class="form-label">Rows</label>
            <select id="rowsPerPage" class="form-select">
              <option value="10">10</option>
              <option value="25" selected>25</option>
              <option value="50">50</option>
              <option value="100">100</option>
            </select>
          </div>

          <div class="col-md-3 text-end">
            <span id="deliveryCount" class="text-muted"></span>
          </div>

        </div>
      </div>
    </div>

  <!-- If no deliveries (no import in this session yet) -->
  <% if (!deliveries || deliveries.length === 0) { %>
    <div class="alert alert-warning">
      No deliveries to show yet for this session. Please import an Excel file.
    </div>
  <% } else { %>

    <!-- Deliveries Table -->
    <table class="table table-bordered table-striped align-middle">
      <thead class="table-dark">
        <tr>
          <th>ID</th>
          <th>Card / Ref #</th>
          <th>Recipient</th>
          <th>Address</th>
          <th>Courier</th>
          <th>Status</th>
          <th>Updated At</th>
          <th>Update Status</th>
        </tr>
      </thead>

      <tbody>
        <% deliveries.forEach(d => { %>
          <tr>
            <td><%= d.id %></td>
            <td><%= d.card_number %></td>
            <td><%= d.recipient_name %></td>
            <td><%= d.address %></td>
            <td><%= d.courier || '-' %></td>

            <td>
              <span class="badge bg-info">
                <%= d.status %>
              </span>
            </td>

            <td>
              <% 
                const dt = d.updated_at ? new Date(d.updated_at) : null;
              %>
              <%= dt ? dt.toISOString().slice(0,19).replace('T',' ') : '-' %>
            </td>

            <td>
              <form method="POST" action="/deliveries/<%= d.id %>/status" class="d-flex gap-1">
                <select name="status" class="form-select form-select-sm">
                  <option value="Pending"             <%= d.status === 'Pending' ? 'selected' : '' %>>Pending</option>
                  <option value="Pulled Out"          <%= d.status === 'Pulled Out' ? 'selected' : '' %>>Pulled Out</option>
                  <option value="Not Found"           <%= d.status === 'Not Found' ? 'selected' : '' %>>Not Found</option>
                  <option value="Handed to Courier"   <%= d.status === 'Handed to Courier' ? 'selected' : '' %>>Handed to Courier</option>
                  <option value="Delivered"           <%= d.status === 'Delivered' ? 'selected' : '' %>>Delivered</option>
                  <option value="Returned to Printer" <%= d.status === 'Returned to Printer' ? 'selected' : '' %>>Returned to Printer</option>
                  <option value="Destroyed"           <%= d.status === 'Destroyed' ? 'selected' : '' %>>Destroyed</option>
                  <option value="Reprocessing"        <%= d.status === 'Reprocessing' ? 'selected' : '' %>>Reprocessing</option>
                </select>

                <button type="submit" class="btn btn-sm btn-primary">Save</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>

  <!-- Pagination -->
  <nav class="d-flex justify-content-center mt-3">
    <ul class="pagination pagination-sm">
      <li class="page-item">
        <button id="prevPage" class="page-link">Prev</button>
      </li>
      <li class="page-item disabled">
        <span id="pageInfo" class="page-link"></span>
      </li>
      <li class="page-item">
        <button id="nextPage" class="page-link">Next</button>
      </li>
    </ul>
  </nav>

  <% } %>

  <%- include('partials/footer') %>

<script>
(() => {
  const tableBody = document.querySelector("tbody");
  if (!tableBody) return; // ✅ no table yet, nothing to paginate/filter

  const rows = Array.from(tableBody.querySelectorAll("tr"));

  const searchInput = document.getElementById("searchInput");
  const statusFilter = document.getElementById("statusFilter");
  const rowsPerPageSelect = document.getElementById("rowsPerPage");
  const pageInfo = document.getElementById("pageInfo");
  const prevBtn = document.getElementById("prevPage");
  const nextBtn = document.getElementById("nextPage");
  const deliveryCount = document.getElementById("deliveryCount");

  let currentPage = 1;
  let rowsPerPage = parseInt(rowsPerPageSelect.value);

  function getFilteredRows() {
    const search = (searchInput.value || "").toLowerCase();
    const status = statusFilter.value;

    return rows.filter(row => {
      const text = row.innerText.toLowerCase();
      const rowStatus = row.children[5]?.innerText.trim();

      if (search && !text.includes(search)) return false;
      if (status && rowStatus !== status) return false;
      return true;
    });
  }

  function render() {
    const filtered = getFilteredRows();
    const totalPages = Math.max(1, Math.ceil(filtered.length / rowsPerPage));
    currentPage = Math.min(currentPage, totalPages);

    rows.forEach(r => r.style.display = "none");

    const start = (currentPage - 1) * rowsPerPage;
    const end = start + rowsPerPage;

    filtered.slice(start, end).forEach(r => (r.style.display = ""));

    pageInfo.textContent = `Page ${currentPage} of ${totalPages}`;
    deliveryCount.textContent = `Showing ${filtered.length} deliveries`;

    prevBtn.disabled = currentPage === 1;
    nextBtn.disabled = currentPage === totalPages;
  }

  searchInput.addEventListener("input", () => { currentPage = 1; render(); });
  statusFilter.addEventListener("change", () => { currentPage = 1; render(); });
  rowsPerPageSelect.addEventListener("change", () => {
    rowsPerPage = parseInt(rowsPerPageSelect.value);
    currentPage = 1;
    render();
  });
  prevBtn.addEventListener("click", () => { if (currentPage > 1) { currentPage--; render(); } });
  nextBtn.addEventListener("click", () => { currentPage++; render(); });

  render();
})();
</script>


</body>
</html>
