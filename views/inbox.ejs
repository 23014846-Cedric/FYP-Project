<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Enquiry Inbox • Operations</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    body {
      background: linear-gradient(to right, #0d6efd, #4dabf7);
      min-height: 100vh;
    }
    .card-box {
      background: #0b1120;
      border-radius: 16px;
      padding: 20px;
      box-shadow: 0 2px 18px rgba(0,0,0,0.4);
      color: #e5e7eb;
    }
    .badge-status-new { background-color: #fbbf24; }
    .badge-status-in_progress { background-color: #38bdf8; }
    .badge-status-closed { background-color: #22c55e; }
    .table-dark td, .table-dark th { vertical-align: middle; }
  </style>
</head>
<body>
  <%- include("partials/navbar") %>
  <div class="sidebar-hover-zone"></div>
  <%- include("partials/sidebar") %>

  <div class="container py-5">
    <div class="card-box">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
          <h2 class="mb-1">Enquiry Inbox</h2>
          <p class="mb-0 text-secondary">
            All messages submitted via the public Contact page. Only Operations & Admin can see this.
          </p>
        </div>
        <span class="badge bg-light text-dark">
          Total: <%= messages.length %>
        </span>
      </div>

      <div class="table-responsive">
        <table class="table table-dark table-hover align-middle">
          <thead>
            <tr>
              <th>Received</th>
              <th>Contact</th>
              <th>Topic</th>
              <th>Message</th>
              <th>Status / Action</th>
            </tr>
          </thead>
          <tbody>
          <% if (!messages.length) { %>
            <tr>
              <td colspan="5" class="text-center text-secondary py-4">
                No enquiries yet.
              </td>
            </tr>
          <% } %>

          <% messages.forEach(m => { %>
            <tr>
              <td style="width: 180px;">
                <div><strong><%= m.createdAt.toLocaleDateString("en-SG") %></strong></div>
                <div class="text-secondary"><%= m.createdAt.toLocaleTimeString("en-SG") %></div>
              </td>

              <td style="width: 220px;">
                <div><strong><%= m.name %></strong></div>
                <div>
                  <a href="mailto:<%= m.email %>" class="text-info text-decoration-none">
                    <%= m.email %>
                  </a>
                </div>
                <% if (m.company) { %>
                  <div class="text-secondary"><%= m.company %></div>
                <% } %>
              </td>

              <td style="width: 150px;">
                <span class="badge bg-secondary text-uppercase">
                  <%= m.topic || '—' %>
                </span>
              </td>

              <td>
                <div style="white-space: pre-wrap;"><%= m.message %></div>
                <% if (m.internalNotes) { %>
                  <small class="d-block mt-2 text-warning">
                    Note: <%= m.internalNotes %>
                  </small>
                <% } %>
              </td>

              <td style="width: 260px;">
                <form method="POST" action="/operations/enquiries/<%= m._id %>">
                  <div class="mb-2">
                    <% if (m.status === 'new') { %>
                      <span class="badge badge-status-new">New</span>
                    <% } else if (m.status === 'in_progress') { %>
                      <span class="badge badge-status-in_progress">In progress</span>
                    <% } else { %>
                      <span class="badge badge-status-closed">Closed</span>
                    <% } %>
                  </div>

                  <div class="mb-2">
                    <select name="status" class="form-select form-select-sm">
                      <option value="new" <%= m.status === 'new' ? 'selected' : '' %>>New</option>
                      <option value="in_progress" <%= m.status === 'in_progress' ? 'selected' : '' %>>In progress</option>
                      <option value="closed" <%= m.status === 'closed' ? 'selected' : '' %>>Closed</option>
                    </select>
                  </div>

                  <div class="mb-2">
                    <textarea
                      name="internalNotes"
                      rows="2"
                      class="form-control form-control-sm"
                      placeholder="Internal notes (not visible to user)"
                    ><%= m.internalNotes || '' %></textarea>
                  </div>

                  <button class="btn btn-sm btn-primary w-100">
                    Update
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <%- include("partials/footer") %>
</body>
</html>
