<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin • User Management</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    /* Main background + spacing for sidebar */
    .content-container {
      padding: 40px 30px;
      background: #f8fafc;
      min-height: 100vh;
    }

    /* Centered inner wrapper */
    .content-inner {
      max-width: 1000px;
      margin: 0 auto;   /* centers horizontally */
    }

    /* Blue header card */
    .blue-card {
      background: linear-gradient(to bottom right, #0d6efd, #4dabf7);
      border-radius: 1.25rem;
      padding: 2rem 2.2rem;
      color: white;
      margin-bottom: 30px;
      box-shadow: 0 20px 45px rgba(0,0,0,0.15);
    }

    .blue-card h1 {
      font-weight: 700;
      font-size: 1.7rem;
      margin-bottom: .3rem;
    }

    .blue-card p {
      opacity: .95;
      font-size: 0.95rem;
    }

    /* White table wrapper */
    .table-wrapper {
      background: white;
      padding: 1.2rem;
      border-radius: 0.8rem;
      border: 1px solid #e2e8f0;
      box-shadow: 0 6px 20px rgba(0,0,0,0.05);
    }

    thead {
      background: #f1f5f9;
      color: #475569;
      font-size: .85rem;
    }

    tbody tr:hover {
      background: #edf6ff;
    }
  </style>
</head>

<body>
  <%- include("partials/navbar") %>
  <div class="sidebar-hover-zone"></div>
  <%- include("partials/sidebar") %>

  <!-- Main page container -->
  <div class="content-container">

    <!-- Centered wrapper -->
    <div class="content-inner">

      <!-- BLUE HEADER CARD -->
      <div class="blue-card">
        <h1>User Management Panel</h1>
        <p>Manage system users, roles, and access permissions.</p>

        <p class="mb-0">
          Logged in as:
          <strong><%= user.name %></strong>
          (<%= user.role %>)
        </p>
      </div>

      <!-- USER TABLE -->
      <div class="table-wrapper">
        <h4 class="mb-3 text-dark">Registered Users</h4>

        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead>
              <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>User ID</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>

            <tbody>
              <% users.forEach((u) => { %>
                <tr>
                  <td><%= u.name %></td>
                  <td><%= u.email %></td>
                  <td>
                    <span class="badge 
                      <%= u.role === 'admin' ? 'bg-danger'
                        : u.role === 'operations' ? 'bg-primary'
                        : 'bg-secondary' %>">
                      <%= u.role %>
                    </span>
                  </td>
                  <td class="text-muted small"><%= u._id %></td>

                  <!-- Actions -->
                  <td class="text-end">
                    <% if (user.role === 'admin' && String(user._id) !== String(u._id)) { %>
                      <button
                        type="button"
                        class="btn btn-sm btn-outline-danger"
                        data-bs-toggle="modal"
                        data-bs-target="#deleteUserModal"
                        data-user-id="<%= u._id %>"
                        data-user-name="<%= u.name %>">
                        Delete
                      </button>
                    <% } else { %>
                      <span class="text-muted small">—</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- BACK BUTTON -->
      <div class="mt-4">
        <a class="btn btn-secondary" href="/dashboard">Back to Dashboard</a>
      </div>

    </div>
  </div>

  <!-- Delete User Confirmation Modal (must be inside body) -->
  <div class="modal fade" id="deleteUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">

        <div class="modal-header">
          <h5 class="modal-title text-danger">Confirm User Deletion</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>

        <div class="modal-body">
          <p>
            Are you sure you want to delete user:
            <strong id="deleteUserName"></strong>?
          </p>
          <p class="text-danger small mb-0">
            This action cannot be undone.
          </p>
        </div>

        <div class="modal-footer">
          <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>

          <form id="deleteUserForm" method="POST">
            <button type="submit" class="btn btn-danger">
              Yes, Delete
            </button>
          </form>
        </div>

      </div>
    </div>
  </div>

  <%- include("partials/footer") %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    const deleteModal = document.getElementById('deleteUserModal');
    const deleteUserName = document.getElementById('deleteUserName');
    const deleteUserForm = document.getElementById('deleteUserForm');

    deleteModal.addEventListener('show.bs.modal', function (event) {
      const button = event.relatedTarget;
      const userId = button.getAttribute('data-user-id');
      const userName = button.getAttribute('data-user-name');

      deleteUserName.textContent = userName;
      deleteUserForm.action = `/admin/users/${userId}/delete`;
    });
  </script>
</body>
</html>
