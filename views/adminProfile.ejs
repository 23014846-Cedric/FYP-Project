<!DOCTYPE html>
<html>
<head>
  <title>Admin - User Management</title>

  <style>
    /* Push content to the right so it doesn't hide under sidebar */
    .content-container {
      margin-left: 240px;    /* enough space for 200px sidebar + hover zone */
      padding: 20px;
    }
  </style>

</head>
<body>
    <%- include("partials/navbar") %>
    <div class="sidebar-hover-zone"></div>
    <%- include("partials/sidebar") %>

  <!-- Use NEW class instead of plain .container -->
  <div class="content-container">
    <h1>Admin Panel - User List</h1>

    <p>Logged in as: <strong><%= user.name %></strong> (<%= user.role %>)</p>

    <table border="1" cellpadding="10" cellspacing="0">
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Role</th>
          <th>User ID</th>
        </tr>
      </thead>

      <tbody>
      <% users.forEach((u) => { %>
        <tr>
          <td><%= u.name %></td>
          <td><%= u.email %></td>
          <td><%= u.role %></td>
          <td><%= u._id %></td>
        </tr>
      <% }) %>
      </tbody>
    </table>

    <br>
    <a href="/dashboard">Back to Dashboard</a>
  </div>

  <%- include("partials/footer") %>
</body>
</html>
