<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin • User Management</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    /* Main background + spacing for sidebar */
    .content-container {
      padding: 40px 30px;
      background: #f8fafc;
      min-height: 100vh;
    }

    /* Centered inner wrapper */
    .content-inner {
      max-width: 1000px;
      margin: 0 auto;   /* centers horizontally */
    }

    /* Blue header card */
    .blue-card {
      background: linear-gradient(to bottom right, #0d6efd, #4dabf7);
      border-radius: 1.25rem;
      padding: 2rem 2.2rem;
      color: white;
      margin-bottom: 30px;
      box-shadow: 0 20px 45px rgba(0,0,0,0.15);
    }

    .blue-card h1 {
      font-weight: 700;
      font-size: 1.7rem;
      margin-bottom: .3rem;
    }

    .blue-card p {
      opacity: .95;
      font-size: 0.95rem;
    }

    /* White table wrapper */
    .table-wrapper {
      background: white;
      padding: 1.2rem;
      border-radius: 0.8rem;
      border: 1px solid #e2e8f0;
      box-shadow: 0 6px 20px rgba(0,0,0,0.05);
    }

    thead {
      background: #f1f5f9;
      color: #475569;
      font-size: .85rem;
    }

    tbody tr:hover {
      background: #edf6ff;
    }
  </style>
</head>

<body>

  <%- include("partials/navbar") %>
  <div class="sidebar-hover-zone"></div>
  <%- include("partials/sidebar") %>

  <!-- Main page container -->
  <div class="content-container">

    <!-- Centered wrapper -->
    <div class="content-inner">

      <!-- BLUE HEADER CARD -->
      <div class="blue-card">
        <h1>User Management Panel</h1>
        <p>Manage system users, roles, and access permissions.</p>

        <p class="mb-0">
          Logged in as:
          <strong><%= user.name %></strong> 
          (<%= user.role %>)
        </p>
      </div>

      <!-- USER TABLE -->
      <div class="table-wrapper">
        <h4 class="mb-3 text-dark">Registered Users</h4>

        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead>
              <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>User ID</th>
              </tr>
            </thead>

            <tbody>
              <% users.forEach((u) => { %>
                <tr>
                  <td><%= u.name %></td>
                  <td><%= u.email %></td>
                  <td><%= u.role %></td>
                  <td class="text-muted small"><%= u._id %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- BACK BUTTON -->
      <div class="mt-4">
        <a class="btn btn-secondary" href="/dashboard">Back to Dashboard</a>
      </div>

    </div> <!-- end content-inner -->

  </div> <!-- end content-container -->

  <%- include("partials/footer") %>
</body>
</html>
