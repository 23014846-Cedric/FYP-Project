<!DOCTYPE html>
<html>
<head>
  <title>Delivery Exceptions</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>

<body class="p-4">
  <%- include("partials/navbar") %>
  <div class="sidebar-hover-zone"></div>
  <%- include("partials/sidebar") %>

  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Delivery Exceptions</h1>
    <p class="text-muted">This page shows all deliveries that were undelivered.</p>
  </div>

  <!-- Exceptions Table -->
  <div class="card">
    <div class="card-header fw-bold">Failed Deliveries</div>

    <div class="card-body p-0">
      <table class="table table-bordered table-striped mb-0">
        <thead class="table-dark">
          <tr>
            <th>ID</th>
            <th>Card #</th>
            <th>Recipient</th>
            <th>Address</th>
            <th>Courier</th>
            <th>Status</th>
            <th>Updated At</th>
            <th>Review</th>
          </tr>
        </thead>

        <tbody>
          <% exceptions.forEach(d => { %>
          <tr>
            <td><%= d._id %></td>
            <td><%= d.card_number %></td>
            <td><%= d.recipient_name %></td>
            <td><%= d.address %></td>
            <td><%= d.courier || '-' %></td>

            <td>
              <span class="badge bg-danger"><%= d.status %></span>
            </td>

            <td><%= d.updated_at.toISOString().slice(0,19).replace("T"," ") %></td>

            <td>
              <a href="#"    
                class="btn btn-sm btn-primary review-btn"
                data-id="<%= d._id %>"
                data-recipient="<%= d.recipient_name %>"
                data-address="<%= d.address %>"
                data-courier="<%= d.courier %>"
                data-status="<%= d.status %>">
                Review
              </a>
            </td>
          </tr>
          <% }) %>
        </tbody>

      </table>
    </div>
  </div>

    <!-- Review Modal -->
    <div class="modal fade" id="reviewModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

        <form method="POST" id="reviewForm">

            <div class="modal-header">
            <h5 class="modal-title">Review Delivery</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

            <input type="hidden" name="id" id="deliveryId">

            <div class="mb-3">
                <label class="form-label">Recipient</label>
                <input type="text" class="form-control" name="recipient" id="recipientInput" required>
            </div>

            <div class="mb-3">
                <label class="form-label">Address</label>
                <textarea class="form-control" name="address" id="addressInput" required></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">Courier</label>
                <input type="text" class="form-control" name="courier" id="courierInput">
            </div>

            <div class="mb-3">
              <select class="form-select" name="status" id="statusInput" required>
                <option value="PENDING" selected>PENDING</option>
                <option value="IN TRANSIT">IN TRANSIT</option>
                <option value="Delivered">Delivered</option>

                <option value="Bad Address">Bad Address</option>
                <option value="Consignee Not Around">Consignee Not Around</option>
                <option value="Denied Entry/Access">Denied Entry/Access</option>
                <option value="Flooded Area">Flooded Area</option>
                <option value="Office Close">Office Close</option>
                <option value="Relocated">Relocated</option>
                <option value="Refuse to Accept">Refuse to Accept</option>
                <option value="Transfer">Transfer</option>
                <option value="Unlocated">Unlocated</option>
                <option value="Return to Centre">Return to Centre</option>
                <option value="Return to Sender">Return to Sender</option>
                <option value="No Updates">No Updates</option>

                <option value="RETURNED">RETURNED</option>
                <option value="FAILED">FAILED</option>
              </select>
            </div>

            </div>

            <div class="modal-footer">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            </div>

        </form>

        </div>
    </div>
    </div>
    
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

        <script>
        const reviewModal = new bootstrap.Modal(document.getElementById('reviewModal'));

        document.querySelectorAll(".review-btn").forEach(btn => {
            btn.addEventListener("click", () => {

            // Fill form fields
            document.getElementById("deliveryId").value = btn.dataset.id;
            document.getElementById("recipientInput").value = btn.dataset.recipient;
            document.getElementById("addressInput").value = btn.dataset.address;
            document.getElementById("courierInput").value = btn.dataset.courier;
            document.getElementById("statusInput").value = btn.dataset.status;

            // Set form action
            document.getElementById("reviewForm").action = `/exceptions/${btn.dataset.id}/update`;

            // Show modal
            reviewModal.show();
            });
        });
        </script>

  <%- include("partials/footer") %>
</body>
</html>
