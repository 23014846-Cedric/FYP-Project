<!DOCTYPE html>
<html>
<head>
  <title>System Activity Log – Audit Trail</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="p-4">
  <%- include("partials/navbar") %>

  <%
    // Safe defaults (prevents crashes if controller forgets to pass these)
    const safePage = (typeof page !== "undefined" && Number(page) > 0) ? Number(page) : 1;
    const safeTotalPages = (typeof totalPages !== "undefined" && Number(totalPages) > 0) ? Number(totalPages) : 1;

    function getRowColor(action) {
      if (action === "UPDATE_STATUS") return "table-success";
      if (action === "LOGIN" || action === "LOGOUT") return "table-warning";
      if (action === "ROLE_UPDATE" || action === "IMPORT_DELIVERIES") return "table-danger";
      return "";
    }

    function buildQuery(overrides = {}) {
      const params = new URLSearchParams();

      if (typeof q !== "undefined" && q !== null && q !== "") params.set("q", String(q));
      if (typeof action !== "undefined" && action !== null && action !== "") params.set("action", String(action));
      if (typeof entity !== "undefined" && entity !== null && entity !== "") params.set("entity", String(entity));
      if (typeof batchId !== "undefined" && batchId !== null && batchId !== "") params.set("batchId", String(batchId));
      if (typeof anchored !== "undefined" && anchored !== null && anchored !== "") params.set("anchored", String(anchored));
      if (typeof from !== "undefined" && from) params.set("from", String(from));
      if (typeof to !== "undefined" && to) params.set("to", String(to));
      if (typeof perPage !== "undefined" && perPage) params.set("perPage", String(perPage));

      params.set("page", String(safePage));

      for (const [k, v] of Object.entries(overrides)) {
        if (v === null || v === undefined || v === "") params.delete(k);
        else params.set(k, String(v));
      }
      return params.toString();
    }

    // Try to extract batchId even if you didn't store it as a field
    function inferBatchId(log) {
      if (!log) return "";
      if (log.import_batch_id) return String(log.import_batch_id);
      if (log.batchId) return String(log.batchId);
      if (log.remarks) {
        const m = String(log.remarks).match(/Batch:\s*([a-f0-9-]+)/i);
        if (m && m[1]) return m[1];
      }
      return "";
    }
  %>

  <div class="sidebar-hover-zone"></div>
  <%- include("partials/sidebar") %>

  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>System Activity Log</h1>
  </div>

  <!-- ================= AUDIT TABS (ONLY ON THIS PAGE) ================= -->
  <ul class="nav nav-tabs mb-3" id="auditTabs" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link active" id="tab-cards" data-bs-toggle="tab" data-bs-target="#pane-cards" type="button" role="tab">
        Summary Cards
      </button>
    </li>

    <li class="nav-item" role="presentation">
      <button class="nav-link" id="tab-graphs" data-bs-toggle="tab" data-bs-target="#pane-graphs" type="button" role="tab">
        Graphs
      </button>
    </li>

    <li class="nav-item" role="presentation">
      <button class="nav-link" id="tab-logs" data-bs-toggle="tab" data-bs-target="#pane-logs" type="button" role="tab">
        Audit Logs
      </button>
    </li>
  </ul>

  <div class="tab-content" id="auditTabsContent">


  <!-- ================= AUDIT SUMMARY CARDS ================= -->
     <div class="tab-pane fade show active" id="pane-cards" role="tabpanel" aria-labelledby="tab-cards">

  <%
    const s = stats || {};
    const num = (v) => (typeof v === "number" ? v : 0);
  %>

  <div class="row g-3 mb-3">
    <!-- Total Users -->
    <div class="col-12 col-sm-6 col-lg-3">
      <div class="card shadow-sm border-0 border-top border-4 border-primary">
        <div class="card-body">
          <div class="fw-semibold">Total Users</div>
          <div class="display-6 fw-bold"><%= num(s.totalUsers) %></div>
          <div class="text-muted small">Records</div>
        </div>
      </div>
    </div>

    <!-- Admin Actions -->
    <div class="col-12 col-sm-6 col-lg-3">
      <div class="card shadow-sm border-0 border-top border-4 border-info">
        <div class="card-body">
          <div class="fw-semibold">Admin Actions</div>
          <div class="display-6 fw-bold"><%= num(s.adminActions) %></div>
          <div class="text-muted small">Records</div>
        </div>
      </div>
    </div>

    <!-- Operations Actions -->
    <div class="col-12 col-sm-6 col-lg-3">
      <div class="card shadow-sm border-0 border-top border-4 border-success">
        <div class="card-body">
          <div class="fw-semibold">Operations Actions</div>
          <div class="display-6 fw-bold"><%= num(s.operationsActions) %></div>
          <div class="text-muted small">Records</div>
        </div>
      </div>
    </div>

    <!-- Courier Actions -->
    <div class="col-12 col-sm-6 col-lg-3">
      <div class="card shadow-sm border-0 border-top border-4 border-warning">
        <div class="card-body">
          <div class="fw-semibold">Courier Actions</div>
          <div class="display-6 fw-bold"><%= num(s.courierActions) %></div>
          <div class="text-muted small">Records</div>
        </div>
      </div>
    </div>

    <!-- Blockchain Anchored -->
    <div class="col-12 col-sm-6 col-lg-3">
      <div class="card shadow-sm border-0 border-top border-4 border-success">
        <div class="card-body">
          <div class="fw-semibold">Blockchain Anchored</div>
          <div class="display-6 fw-bold"><%= num(s.blockchainAnchored) %></div>
          <div class="text-muted small">Records</div>
        </div>
      </div>
    </div>

    <!-- Blockchain Pending -->
    <div class="col-12 col-sm-6 col-lg-3">
      <div class="card shadow-sm border-0 border-top border-4 border-warning">
        <div class="card-body">
          <div class="fw-semibold">Blockchain Pending</div>
          <div class="display-6 fw-bold"><%= num(s.blockchainPending) %></div>
          <div class="text-muted small">Records</div>
        </div>
      </div>
    </div>

    <!-- Update Status -->
    <div class="col-12 col-sm-6 col-lg-3">
      <div class="card shadow-sm border-0 border-top border-4 border-primary">
        <div class="card-body">
          <div class="fw-semibold">Update Status</div>
          <div class="display-6 fw-bold"><%= num(s.updateStatus) %></div>
          <div class="text-muted small">Records</div>
        </div>
      </div>
    </div>

    <!-- Import Deliveries -->
    <div class="col-12 col-sm-6 col-lg-3">
      <div class="card shadow-sm border-0 border-top border-4 border-danger">
        <div class="card-body">
          <div class="fw-semibold">Import Deliveries</div>
          <div class="display-6 fw-bold"><%= num(s.importDeliveries) %></div>
          <div class="text-muted small">Records</div>
        </div>
      </div>
    </div>

    <!-- Role Updates -->
    <div class="col-12 col-sm-6 col-lg-3">
      <div class="card shadow-sm border-0 border-top border-4 border-dark">
        <div class="card-body">
          <div class="fw-semibold">Role Updates</div>
          <div class="display-6 fw-bold"><%= num(s.roleUpdates) %></div>
          <div class="text-muted small">Records</div>
        </div>
      </div>
    </div>
  </div>

  <!-- ======================================================= -->

  <%
    const sodWarnings = [];
    if ((stats?.operationsActions || 0) > 0 && (stats?.roleUpdates || 0) > 0) {
      sodWarnings.push("Operations role performed ROLE_UPDATE actions (SoD risk).");
    }
    if ((stats?.courierActions || 0) > 0 && (stats?.importDeliveries || 0) > 0) {
      sodWarnings.push("Courier role performed IMPORT_DELIVERIES actions (unexpected behaviour).");
    }
  %>


    </div> <!-- end Summary Cards tab -->


  <div class="tab-pane fade" id="pane-graphs" role="tabpanel" aria-labelledby="tab-graphs">

    <button id="exportPdf" class="btn btn-outline-dark" style="background-color: green; color: white;">Export Charts to PDF</button>
    <p> </p>
  <!-- ================= AUDIT CHARTS ================= -->
   
<div id="auditCharts">

  <div class="row g-3 mb-3">

    <div class="col-12">
      <div class="card shadow-sm">
        <div class="card-body">
          <h6 class="mb-2">Actions Over Time</h6>
          <canvas id="chartActionsOverTime" height="140"></canvas>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <div class="card shadow-sm">
        <div class="card-body">
          <h6 class="mb-2">Actions by Type</h6>
          <canvas id="chartActionsByType"></canvas>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <div class="card shadow-sm">
        <div class="card-body">
          <h6 class="mb-2">Actions by Role</h6>
          <canvas id="chartActionsByRole"></canvas>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <div class="card shadow-sm">
        <div class="card-body">
          <h6 class="mb-2">Top Active Users</h6>
          <canvas id="chartTopUsers"></canvas>
        </div>
      </div>
    </div>


    <div class="col-md-6">
      <div class="card shadow-sm">
        <div class="card-body">
          <h6 class="mb-2">Status Updates vs Exceptions</h6>
          <canvas id="chartStatusVsExceptions"></canvas>
        </div>
      </div>
    </div>

  </div>

</div>
  </div> <!-- end Graphs tab -->

  <!-- ======================================================= -->

  <!-- ================= FILTERS & CONTROLS ================= -->
     <div class="tab-pane fade" id="pane-logs" role="tabpanel" aria-labelledby="tab-logs">


  <form class="card border-0 shadow-sm mb-3" method="GET" action="/auditLog">
    <div class="card-body">
      <div class="row g-2 align-items-end">
        <div class="col-12 col-lg-4">
          <label class="form-label small mb-1">Search</label>
          <input class="form-control" name="q" value="<%= q || '' %>" placeholder="user, entity id, remarks, hash, tx..." />
        </div>

        <div class="col-6 col-lg-2">
          <label class="form-label small mb-1">Action</label>
          <select class="form-select" name="action">
            <option value="">All</option>
            <% (actionList || []).forEach(a => { %>
              <option value="<%= a %>" <%= (action === a ? 'selected' : '') %>><%= a %></option>
            <% }) %>
          </select>
        </div>

        <div class="col-6 col-lg-2">
          <label class="form-label small mb-1">Entity</label>
          <select class="form-select" name="entity">
            <option value="">All</option>
            <% (entityList || []).forEach(e => { %>
              <option value="<%= e %>" <%= (entity === e ? 'selected' : '') %>><%= e %></option>
            <% }) %>
          </select>
        </div>

        <div class="col-6 col-lg-2">
          <label class="form-label small mb-1">Blockchain</label>
          <select class="form-select" name="anchored">
            <option value="" <%= (!anchored ? 'selected' : '') %>>All</option>
            <option value="anchored" <%= (anchored === 'anchored' ? 'selected' : '') %>>Anchored</option>
            <option value="pending" <%= (anchored === 'pending' ? 'selected' : '') %>>Pending</option>
          </select>
        </div>

        <div class="col-6 col-lg-2">
          <label class="form-label small mb-1">Per page</label>
          <select class="form-select" name="perPage">
            <% [10,20,50,100].forEach(n => { %>
              <option value="<%= n %>" <%= (Number(perPage) === n ? 'selected' : '') %>><%= n %></option>
            <% }) %>
          </select>
        </div>

        <div class="col-6 col-lg-2">
          <label class="form-label small mb-1">From</label>
          <input type="date" class="form-control" name="from" value="<%= from || '' %>"/>
        </div>

        <div class="col-6 col-lg-2">
          <label class="form-label small mb-1">To</label>
          <input type="date" class="form-control" name="to" value="<%= to || '' %>"/>
        </div>

        <div class="col-12 col-lg-4">
          <label class="form-label small mb-1">Batch ID (import/anchor)</label>
          <input class="form-control" name="batchId" value="<%= batchId || '' %>" placeholder="paste batch id"/>
        </div>

        <div class="col-12 d-flex gap-2 mt-2">
          <button class="btn btn-primary">Apply</button>
          <a class="btn btn-outline-secondary" href="/auditLog">Reset</a>
        </div>
      </div>
    </div>
  </form>

  <!-- ======================================================= -->

  <!-- ================= Export ================= -->

  <div class="d-flex gap-2 mb-3">
    <button id="exportExcel" class="btn btn-success">Export to Excel</button>
  </div>

  <!-- ======================================================= -->

  <table class="table table-bordered table-striped table-sm align-middle">
    <thead class="table-dark">
      <tr>
        <th>Action Time (SG)</th>
        <th>Blockchain Time (SG)</th>
        <th>User</th>
        <th>Action</th>
        <th>Entity</th>
        <th>Entity ID</th>
        <th>Source</th>
        <th>Old → New</th>
        <th>Remarks</th>
        <th>Details</th>
        <th>Blockchain</th>
        <th>Tx Hash</th>
      </tr>
    </thead>

    <tbody>
      <% if (logs && logs.length > 0) { %>
        <% logs.forEach(log => { %>
          <%
            const inferredBatch = inferBatchId(log);
            const isImport = (log.action_type === "IMPORT_DELIVERIES" && inferredBatch);
            const collapseId = isImport ? ("imp_" + inferredBatch) : null;
          %>

          <!-- MAIN ROW -->
          <tr class="<%= getRowColor(log.action_type) %>">
            <td>
              <%= new Date(log.action_timestamp || log.timestamp)
                .toLocaleString("en-SG", { timeZone: "Asia/Singapore" }) %>
            </td>

            <td>
              <%= log.timestamp ? new Date(log.timestamp).toLocaleString("en-SG", { timeZone: "Asia/Singapore" }) : "-" %>
            </td>

            <td><strong><%= log.username || log.user_email || "System" %></strong></td>
            <% const suspiciousSafe = (typeof suspicious !== "undefined" && suspicious) ? suspicious : {}; %>

            <td>
              <%= log.action_type || "-" %>
              <% const flag = suspiciousSafe[String(log._id)]; %>
              <% if (flag) { %>
                <span
                  class="badge bg-danger ms-2"
                  title="<%= String((flag.reasons || []).join(' | ')).replace(/"/g, '&quot;') %>"
                >
                  Flagged
                </span>
              <% } %>
            </td>

            <td><%= log.entity_type || "-" %></td>
            <td><code><%= log.entity_id || "-" %></code></td>
            <td><%= log.source || "Web" %></td>

            <td style="max-width: 420px; font-size: 0.85rem;">
              <% if (log.field && (log.old_value || log.new_value)) { %>
                <div>
                  <strong><code><%= log.field %></code>:</strong>
                  <code><%= (log.old_value !== undefined && log.old_value !== null) ? log.old_value : "-" %></code>
                  &nbsp;&rarr;&nbsp;
                  <code><%= (log.new_value !== undefined && log.new_value !== null) ? log.new_value : "-" %></code>
                </div>
              <% } else if (log.old_value || log.new_value) { %>
                <div><strong>Old:</strong> <code><%= (log.old_value ?? "-") %></code></div>
                <div><strong>New:</strong> <code><%= (log.new_value ?? "-") %></code></div>
              <% } else { %>
                <span class="text-muted">No value change recorded</span>
              <% } %>
            </td>

            <td><%= log.remarks || "" %></td>

            <!-- Details -->
            <td class="text-center" style="min-width: 180px;">
              <% if (isImport) { %>
                <button
                  class="btn btn-sm btn-outline-primary btn-toggle-import"
                  type="button"
                  data-target="<%= collapseId %>"
                  data-batch="<%= inferredBatch %>"
                >
                  View
                </button>
                <div class="small text-muted mt-1">Batch: <code><%= inferredBatch %></code></div>
              <% } else { %>
                <span class="text-muted">-</span>
              <% } %>
            </td>

            <!-- Blockchain -->
            <td style="min-width: 220px;">
              <% if (log.anchored && log.anchor_tx) { %>
                <span class="badge bg-success">Anchored ✅</span>
                <div class="small text-muted mt-1">
                  root: <code><%= (log.anchor_root || "").slice(0, 10) %>…</code>
                </div>
              <% } else if (log.hash) { %>
                <span class="badge bg-warning text-dark">Hashed (pending anchor)</span>
                <div class="small text-muted mt-1">
                  hash: <code><%= log.hash.slice(0, 10) %>…</code><br/>
                  prev: <code><%= log.prev_hash ? log.prev_hash.slice(0, 10) + "…" : "-" %></code>
                </div>
              <% } else { %>
                <span class="text-muted">No hash</span>
              <% } %>
            </td>

            <!-- Tx Hash -->
            <td style="max-width: 260px; font-size: 0.78rem;">
              <% if (log.anchor_tx) { %>
                <code><%= log.anchor_tx %></code>
              <% } else { %>
                <span class="text-muted">-</span>
              <% } %>
            </td>
          </tr>
          <!-- COLLAPSE ROW (IMPORT ONLY) -->
          <% if (isImport) { %>
            <tr>
              <td colspan="11" class="p-0">
                <div class="collapse" id="<%= collapseId %>">
                  <div class="p-3 bg-light border-top">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                      <div>
                        <strong>Imported Deliveries Preview</strong>
                        <div class="small text-muted">
                          Batch: <code><%= inferredBatch %></code> (loads first 50)
                        </div>
                      </div>
                    </div>

                    <div id="batch-body-<%= inferredBatch %>" class="mt-3">
                      <div class="text-muted small">Click “View” to load records…</div>
                    </div>
                  </div>
                </div>
              </td>
            </tr>
          <% } %>

        <% }) %>
      <% } else { %>
        <tr>
          <td colspan="11" class="text-center text-muted">No audit log entries found.</td>
        </tr>
      <% } %>
    </tbody>
  </table>

  <!-- Pagination -->
  <nav class="d-flex justify-content-center mt-3" aria-label="Audit pagination">
    <ul class="pagination pagination-sm">
      <li class="page-item <%= (safePage <= 1 ? 'disabled' : '') %>">
        <a class="page-link" href="/auditLog?<%= buildQuery({ page: Math.max(1, safePage - 1), tab: 'logs' }) %>">Prev</a>
      </li>

      <%
        const start = Math.max(1, safePage - 3);
        const end = Math.min(safeTotalPages, safePage + 3);
      %>

      <% if (start > 1) { %>
        <li class="page-item"><a class="page-link" href="/auditLog?<%= buildQuery({ page: 1, tab: 'logs' }) %>">1</a></li>
        <% if (start > 2) { %><li class="page-item disabled"><span class="page-link">…</span></li><% } %>
      <% } %>

      <% for (let p = start; p <= end; p++) { %>
        <li class="page-item <%= (p === safePage ? 'active' : '') %>">
          <a class="page-link" href="/auditLog?<%= buildQuery({ page: p, tab: 'logs'}) %>"><%= p %></a>
        </li>
      <% } %>

      <% if (end < safeTotalPages) { %>
        <% if (end < safeTotalPages - 1) { %><li class="page-item disabled"><span class="page-link">…</span></li><% } %>
        <li class="page-item"><a class="page-link" href="/auditLog?<%= buildQuery({ page: safeTotalPages, tab: 'logs' }) %>"><%= safeTotalPages %></a></li>
      <% } %>

      <li class="page-item <%= (safePage >= safeTotalPages ? 'disabled' : '') %>">
        <a class="page-link" href="/auditLog?<%= buildQuery({ page: Math.min(safeTotalPages, safePage + 1), tab: 'logs' }) %>">Next</a>
      </li>
    </ul>
  </nav>

  <a href="/deliveries" class="btn btn-secondary mt-3">Back to Deliveries</a>

  <footer class="bg-dark text-white py-3 mt-4">
    <div class="container text-center">
      <p class="mb-0 text-sm">&copy; Placeholder TXT</p>
    </div>
  </footer>
  </div> <!-- end Audit Logs tab -->
</div> <!-- end tab-content -->

  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/xlsx/dist/xlsx.full.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>

  
  <script>
    const CHART = JSON.parse('<%- JSON.stringify(chartData || {}) %>');

      // ================= KEEP ACTIVE TAB ON RELOAD =================
  function setUrlTab(tabName) {
    const url = new URL(window.location.href);
    url.searchParams.set("tab", tabName);
    window.history.replaceState({}, "", url);
  }

  function getUrlTab() {
    return new URL(window.location.href).searchParams.get("tab");
  }

  // Update URL when switching tabs
  document.getElementById("tab-cards")?.addEventListener("shown.bs.tab", () => setUrlTab("cards"));
  document.getElementById("tab-graphs")?.addEventListener("shown.bs.tab", () => setUrlTab("graphs"));
  document.getElementById("tab-logs")?.addEventListener("shown.bs.tab", () => setUrlTab("logs"));

  // Restore tab on page load (pagination reload)
  document.addEventListener("DOMContentLoaded", () => {
    const tab = getUrlTab();
    if (!tab) return;

    const map = { cards: "tab-cards", graphs: "tab-graphs", logs: "tab-logs" };
    const btn = document.getElementById(map[tab]);
    if (btn) new bootstrap.Tab(btn).show();
  });


    const RED = "rgba(255,99,132,0.9)";
    const palette = [
      "rgba(54,162,235,0.75)",
      "rgba(75,192,192,0.75)",
      "rgba(255,159,64,0.75)",
      "rgba(153,102,255,0.75)",
      "rgba(255,205,86,0.75)",
      "rgba(201,203,207,0.75)",
      "rgba(99,255,132,0.75)",
      "rgba(235,54,162,0.75)",
    ];

    function colorsForLabels(labels, forceRedSet = new Set()) {
      return (labels || []).map((lab, i) => {
        const key = String(lab);
        if (forceRedSet.has(key)) return RED;
        return palette[i % palette.length];
      });
    }

    function goFilter(params) {
      const url = new URL(window.location.href);
      Object.entries(params).forEach(([k, v]) => {
        if (v === null || v === undefined || v === "") url.searchParams.delete(k);
        else url.searchParams.set(k, String(v));
      });
      url.searchParams.set("page", "1");
      window.location.href = url.toString();
    }

    function makeBar(id, labels, data, forceRedSet, onClick) {
      const el = document.getElementById(id);
      if (!el) return;

      const bg = colorsForLabels(labels, forceRedSet);

      return new Chart(el, {
        type: "bar",
        data: {
          labels,
          datasets: [{
            label: "Count",
            data,
            backgroundColor: bg,
            borderColor: bg
          }]
        },
        options: {
          responsive: true,
          plugins: { legend: { display: false } },
          scales: { y: { beginAtZero: true } },
          onClick
        }
      });
    }

    // ✅ 1) Actions Over Time (Line) — ensure it shows
    (() => {
      const el = document.getElementById("chartActionsOverTime");
      if (!el) return;

      const d = CHART.actionsOverTime || { labels: [], total: [], importDeliveries: [], updateStatus: [] };

      new Chart(el, {
        type: "line",
        data: {
          labels: d.labels || [],
          datasets: [
            {
              label: "Total",
              data: d.total || [],
              borderColor: "rgba(54,162,235,0.9)",
              backgroundColor: "rgba(54,162,235,0.25)",
              fill: false,
              tension: 0.35
            },
            {
              label: "IMPORT_DELIVERIES",
              data: d.importDeliveries || [],
              borderColor: "rgba(255,159,64,0.9)",
              backgroundColor: "rgba(255,159,64,0.25)",
              fill: false,
              tension: 0.35
            },
            {
              label: "UPDATE_STATUS",
              data: d.updateStatus || [],
              borderColor: "rgba(75,192,192,0.9)",
              backgroundColor: "rgba(75,192,192,0.25)",
              fill: false,
              tension: 0.35
            },
          ]
        },
        options: {
          responsive: true,
          plugins: { legend: { position: "top" } },
          scales: { y: { beginAtZero: true } }
        }
      });
    })();

    // ✅ 2) Actions by Type — each bar different, sensitive reveal RED, clickable
    makeBar(
      "chartActionsByType",
      (CHART.actionsByType?.labels || []),
      (CHART.actionsByType?.counts || []),
      new Set(["SENSITIVE_REVEAL_GRANTED", "SENSITIVE_REVEAL", "SENSITIVE_REVEAL_GRANTED", "REVEAL", "REVEAL_SENSITIVE"]),
      (evt, elements, chart) => {
        if (!elements.length) return;
        const action = chart.data.labels[elements[0].index];
        goFilter({ action });
      }
    );

    // ✅ 3) Actions by Role — each bar different, unknown RED (your backend makes order stable)
    makeBar(
      "chartActionsByRole",
      (CHART.actionsByRole?.labels || []),
      (CHART.actionsByRole?.counts || []),
      new Set(["unknown"]),
      null
    );

    // ✅ 4) Top Users — each bar different, clickable (filters search q)
    makeBar(
      "chartTopUsers",
      (CHART.topUsers?.labels || []),
      (CHART.topUsers?.counts || []),
      new Set([]),
      (evt, elements, chart) => {
        if (!elements.length) return;
        const username = chart.data.labels[elements[0].index];
        goFilter({ q: username });
      }
    );

    // ✅ 5) Login vs Failed Login — failed RED, clickable
    makeBar(
      "chartLoginVsFailed",
      (CHART.loginVsFailed?.labels || ["LOGIN", "FAILED_LOGIN"]),
      (CHART.loginVsFailed?.counts || [0, 0]),
      new Set(["FAILED_LOGIN"]),
      (evt, elements, chart) => {
        if (!elements.length) return;
        const a = chart.data.labels[elements[0].index];
        goFilter({ action: a });
      }
    );

    // ✅ 6) Status Updates vs Exceptions — failed deliveries RED, should show
    makeBar(
      "chartStatusVsExceptions",
      (CHART.statusVsExceptions?.labels || ["UPDATE_STATUS", "FAILED_DELIVERIES"]),
      (CHART.statusVsExceptions?.counts || [0, 0]),
      new Set(["FAILED_DELIVERIES"]),
      null
    );


    // =========================
    // 1) IMPORT COLLAPSE TOGGLE
    // =========================
    const loadedBatches = new Set();

    async function loadBatch(batchId) {
      if (!batchId) return;
      if (loadedBatches.has(batchId)) return;
      loadedBatches.add(batchId);

      const container = document.getElementById("batch-body-" + batchId);
      if (!container) return;

      container.innerHTML = `<div class="text-muted small">Loading...</div>`;

      try {
        const res = await fetch(`/api/import-batch/${encodeURIComponent(batchId)}?limit=50`);
        const data = await res.json();

        if (!res.ok || !data.ok) {
          container.innerHTML = `<div class="text-danger small">Failed to load imported records.</div>`;
          return;
        }

        const deliveries = data.deliveries || [];
        if (deliveries.length === 0) {
          container.innerHTML = `<div class="text-muted small">No records found for this batch.</div>`;
          return;
        }

        const rows = deliveries.map(d => `
          <tr>
            <td><code>${d.card_number || "-"}</code></td>
            <td>${d.recipient_name || "-"}</td>
            <td>${d.address || "-"}</td>
            <td>${d.courier || "-"}</td>
            <td>${d.status || "-"}</td>
          </tr>
        `).join("");

        container.innerHTML = `
          <div class="table-responsive">
            <table class="table table-sm table-bordered align-middle mb-0">
              <thead class="table-secondary">
                <tr>
                  <th>Card/Ref</th>
                  <th>Recipient</th>
                  <th>Address</th>
                  <th>Courier</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>${rows}</tbody>
            </table>
          </div>
          <div class="small text-muted mt-2">Showing ${deliveries.length} records (preview limit).</div>
        `;
      } catch (e) {
        container.innerHTML = `<div class="text-danger small">Error: ${e.message || e}</div>`;
      }
    }

    // Manual toggle so clicking again CLOSES it
    document.querySelectorAll(".btn-toggle-import").forEach(btn => {
      btn.addEventListener("click", async () => {
        const targetId = btn.dataset.target;   // e.g. "imp_<uuid>"
        const batchId = btn.dataset.batch;

        const el = document.getElementById(targetId);
        if (!el) return;

        const isOpen = el.classList.contains("show");
        const instance = bootstrap.Collapse.getOrCreateInstance(el, { toggle: false });

        // load once when opening
        if (!isOpen) {
          await loadBatch(batchId);
          btn.textContent = "Hide";
        } else {
          btn.textContent = "View";
        }

        instance.toggle();
      });
    });

    // If collapse is closed via other means, reset button text properly
    document.querySelectorAll(".collapse").forEach(col => {
      col.addEventListener("hidden.bs.collapse", () => {
        const id = col.getAttribute("id");
        const btn = document.querySelector(`.btn-toggle-import[data-target="${id}"]`);
        if (btn) btn.textContent = "View";
      });
      col.addEventListener("shown.bs.collapse", () => {
        const id = col.getAttribute("id");
        const btn = document.querySelector(`.btn-toggle-import[data-target="${id}"]`);
        if (btn) btn.textContent = "Hide";
      });
    });

    // =========================
    // 2) PDF EXPORT (CHARTS ONLY)
    // =========================
    document.getElementById("exportPdf")?.addEventListener("click", async () => {
      try {
        console.log("[PDF] clicked");

        if (!window.html2canvas) {
          alert("html2canvas not loaded. Check the script include.");
          return;
        }
        if (!window.jspdf || !window.jspdf.jsPDF) {
          alert("jsPDF not loaded. Check the script include.");
          return;
        }

        const chartsEl = document.getElementById("auditCharts");
        if (!chartsEl) {
          alert("Cannot find #auditCharts. Your charts must be inside <div id='auditCharts'>...</div>.");
          return;
        }

        // Render charts section to canvas
        const canvas = await html2canvas(chartsEl, {
          scale: 2,
          useCORS: true,
          backgroundColor: "#ffffff",
          scrollX: 0,
          scrollY: -window.scrollY,
        });

        const imgData = canvas.toDataURL("image/png");
        const { jsPDF } = window.jspdf;

        // A4 portrait
        const pdf = new jsPDF("p", "mm", "a4");
        const pageWidth = pdf.internal.pageSize.getWidth();
        const pageHeight = pdf.internal.pageSize.getHeight();

        // Fit image to page width
        const imgWidth = pageWidth;
        const imgHeight = (canvas.height * imgWidth) / canvas.width;

        // Multi-page support
        let position = 0;
        let heightLeft = imgHeight;

        pdf.addImage(imgData, "PNG", 0, position, imgWidth, imgHeight);
        heightLeft -= pageHeight;

        while (heightLeft > 0) {
          pdf.addPage();
          position = heightLeft - imgHeight; // shift up on next page
          pdf.addImage(imgData, "PNG", 0, position, imgWidth, imgHeight);
          heightLeft -= pageHeight;
        }

        pdf.save("audit_charts.pdf");
      } catch (err) {
        console.error("[PDF][ERROR]", err);
        alert("Export failed: " + (err?.message || err));
      }
    });
    // =========================
    // 2) EXCEL EXPORT
    // =========================
    document.getElementById("exportExcel").addEventListener("click", () => {
      const table = document.querySelector("table");
      const ws = XLSX.utils.table_to_sheet(table);
      const range = XLSX.utils.decode_range(ws["!ref"]);

      for (let R = range.s.r + 1; R <= range.e.r; ++R) {
        const cellRef = XLSX.utils.encode_cell({ r: R, c: 0 });
        const cell = ws[cellRef];
        if (cell?.v) {
          const dateObj = new Date(cell.v);
          if (!isNaN(dateObj.getTime())) {
            cell.v = dateObj;
            cell.t = "d";
            cell.z = "yyyy-mm-dd hh:mm:ss";
          }
        }
      }

      const wb = XLSX.utils.book_new();
      XLSX.utils.book_append_sheet(wb, ws, "Audit Logs");
      XLSX.writeFile(wb, "audit_logs.xlsx");
    });

    // =========================
    // 3) OPTIONAL: GANACHE ANCHOR
    // =========================
    const CONTRACT_ADDRESS = "0xF9cC401278b0Cd6a1Ebe54282B0015b0cA0aF7D1";

    const CONTRACT_ABI = [
      {
        "anonymous": false,
        "inputs": [
          { "indexed": true, "internalType": "address", "name": "user", "type": "address" },
          { "indexed": true, "internalType": "bytes32", "name": "logHash", "type": "bytes32" },
          { "indexed": false, "internalType": "string", "name": "actionType", "type": "string" },
          { "indexed": false, "internalType": "uint256", "name": "timestamp", "type": "uint256" }
        ],
        "name": "AuditLogged",
        "type": "event"
      },
      {
        "inputs": [
          { "internalType": "bytes32", "name": "logHash", "type": "bytes32" },
          { "internalType": "string", "name": "actionType", "type": "string" }
        ],
        "name": "logAudit",
        "outputs": [],
        "stateMutability": "nonpayable",
        "type": "function"
      }
    ];

    async function anchorLog(auditLogId, logHash, actionType, buttonEl) {
      if (!window.ethereum) {
        alert("MetaMask not detected. Please install MetaMask.");
        return;
      }

      if (!CONTRACT_ADDRESS) {
        alert("Missing CONTRACT_ADDRESS in auditLog.ejs");
        return;
      }

      const provider = new ethers.providers.Web3Provider(window.ethereum);
      await provider.send("eth_requestAccounts", []);

      const signer = provider.getSigner();
      const contract = new ethers.Contract(CONTRACT_ADDRESS, CONTRACT_ABI, signer);

      if (buttonEl) {
        buttonEl.disabled = true;
        buttonEl.textContent = "Anchoring...";
      }

      const tx = await contract.logAudit(logHash, actionType, { gasLimit: 200000 });
      const receipt = await tx.wait();
      const txHash = receipt.transactionHash;

      const res = await fetch(`/api/audit/${auditLogId}/tx`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ txHash })
      });

      if (!res.ok) {
        const msg = await res.text();
        alert("Saved on-chain but failed to update DB: " + msg);
        return;
      }

      window.location.reload();
    }

    document.querySelectorAll(".anchor-btn").forEach(btn => {
      btn.addEventListener("click", async () => {
        try {
          await anchorLog(btn.dataset.id, btn.dataset.hash, btn.dataset.action, btn);
        } catch (err) {
          console.error(err);
          alert(err?.message || String(err));
          btn.disabled = false;
          btn.textContent = "Anchor to Ganache";
        }
      });
    });
  </script>
</body>
</html>
