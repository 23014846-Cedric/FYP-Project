<!DOCTYPE html>
<html>
<head>
  <title>System Activity Log – Audit Trail</title>
  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="p-4">
  <%- include("partials/navbar") %>

  <%
    function getRowColor(action) {
      if (action === "UPDATE_STATUS") return "table-success"; // green
      if (action === "LOGIN" || action === "LOGOUT") return "table-warning"; // yellow
      if (action === "ROLE_UPDATE" || action === "IMPORT_DELIVERIES") return "table-danger"; // red
      return "";
    }
  %>

  <div class="sidebar-hover-zone"></div>
  <%- include("partials/sidebar") %>

  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>System Activity Log</h1>
  </div>

  <button id="exportExcel" class="btn btn-success mb-3">Export to Excel</button>

  <table class="table table-bordered table-striped table-sm align-middle">
    <thead class="table-dark">
      <tr>
        <th>Time</th>
        <th>User</th>
        <th>Action</th>
        <th>Entity</th>
        <th>Entity ID</th>
        <th>Source</th>
        <th>Old → New (What changed)</th>
        <th>Remarks</th>

        <!-- ✅ NEW -->
        <th>Blockchain</th>
        <th>Tx Hash</th>
      </tr>
    </thead>

    <tbody>
      <% if (logs && logs.length > 0) { %>
        <% logs.forEach(log => { %>
          <tr class="<%= getRowColor(log.action_type) %>">
            <!-- Time -->
            <td>
              <% if (log.timestamp) { %>
                <%= new Date(log.timestamp).toLocaleString("en-SG", { timeZone: "Asia/Singapore" }) %>
              <% } else { %>
                -
              <% } %>
            </td>

            <!-- User -->
            <td>
              <strong><%= log.username || log.user_email || 'System' %></strong>
            </td>

            <!-- Action -->
            <td><%= log.action_type || '-' %></td>

            <!-- Entity -->
            <td><%= log.entity_type || '-' %></td>

            <!-- Entity ID -->
            <td><code><%= log.entity_id || '-' %></code></td>

            <!-- Source -->
            <td><%= log.source || 'Web' %></td>

            <!-- Old → New -->
            <td style="max-width: 420px; font-size: 0.85rem;">
              <% if (log.field && (log.old_value || log.new_value)) { %>
                <div>
                  <strong><code><%= log.field %></code>:</strong>
                  <code><%= log.old_value !== undefined && log.old_value !== null ? log.old_value : '-' %></code>
                  &nbsp;&rarr;&nbsp;
                  <code><%= log.new_value !== undefined && log.new_value !== null ? log.new_value : '-' %></code>
                </div>
              <% } else if (log.old_value || log.new_value) { %>
                <div>
                  <strong>Old:</strong>
                  <code><%= log.old_value !== undefined ? log.old_value : '-' %></code>
                </div>
                <div>
                  <strong>New:</strong>
                  <code><%= log.new_value !== undefined ? log.new_value : '-' %></code>
                </div>
              <% } else { %>
                <span class="text-muted">No value change recorded</span>
              <% } %>
            </td>

            <!-- Remarks -->
            <td><%= log.remarks || '' %></td>

            <!-- ✅ Blockchain Status -->
            <td style="min-width: 170px;">
              <% if (log.txHash) { %>
                <span class="badge bg-success">Anchored ✅</span>
              <% } else if (log.logHash) { %>
                <button
                  class="btn btn-sm btn-outline-primary anchor-btn"
                  data-id="<%= log._id %>"
                  data-hash="<%= log.logHash %>"
                  data-action="<%= log.action_type || 'UNKNOWN' %>">
                  Anchor to Ganache
                </button>
                <div class="small text-muted mt-1">
                  Hash: <code><%= log.logHash %></code>
                </div>
              <% } else { %>
                <span class="text-muted">No hash</span>
              <% } %>
            </td>

            <!-- ✅ Tx Hash -->
            <td style="max-width: 260px; font-size: 0.78rem;">
              <% if (log.txHash) { %>
                <code><%= log.txHash %></code>
              <% } else { %>
                <span class="text-muted">-</span>
              <% } %>
            </td>

          </tr>
        <% }) %>
      <% } else { %>
        <tr>
          <td colspan="10" class="text-center text-muted">
            No audit log entries found.
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>

  <a href="/deliveries" class="btn btn-secondary">Back to Deliveries</a>

  <footer class="bg-dark text-white py-3 mt-4">
    <div class="container text-center">
      <p class="mb-0 text-sm">&copy; Placeholder TXT</p>
    </div>
  </footer>

  <!-- XLSX -->
  <script src="https://cdn.jsdelivr.net/npm/xlsx/dist/xlsx.full.min.js"></script>

  <!-- ✅ Ethers (v5 works best with Ganache + MetaMask) -->
  <script src="https://cdn.jsdelivr.net/npm/ethers@5.7.2/dist/ethers.umd.min.js"></script>

  <script>
    // ✅ Paste your deployed Ganache contract address here
    const CONTRACT_ADDRESS = "0xF9cC401278b0Cd6a1Ebe54282B0015b0cA0aF7D1";

    // ABI for logAudit + event (works for both "event-only" and "mapping" contract)
    const CONTRACT_ABI = [
      {
        "anonymous": false,
        "inputs": [
          { "indexed": true, "internalType": "address", "name": "user", "type": "address" },
          { "indexed": true, "internalType": "bytes32", "name": "logHash", "type": "bytes32" },
          { "indexed": false, "internalType": "string", "name": "actionType", "type": "string" },
          { "indexed": false, "internalType": "uint256", "name": "timestamp", "type": "uint256" }
        ],
        "name": "AuditLogged",
        "type": "event"
      },
      {
        "inputs": [
          { "internalType": "bytes32", "name": "logHash", "type": "bytes32" },
          { "internalType": "string", "name": "actionType", "type": "string" }
        ],
        "name": "logAudit",
        "outputs": [],
        "stateMutability": "nonpayable",
        "type": "function"
      }
    ];

    async function anchorLog(auditLogId, logHash, actionType, buttonEl) {
      if (!window.ethereum) {
        alert("MetaMask not detected. Please install MetaMask.");
        return;
      }

      if (!CONTRACT_ADDRESS || CONTRACT_ADDRESS.includes("PASTE_")) {
        alert("You must paste your CONTRACT_ADDRESS into auditLog.ejs first.");
        return;
      }

      // Connect MetaMask
      const provider = new ethers.providers.Web3Provider(window.ethereum);
      await provider.send("eth_requestAccounts", []);

      const signer = provider.getSigner();
      const contract = new ethers.Contract(CONTRACT_ADDRESS, CONTRACT_ABI, signer);

      // Optional: show some UI feedback
      if (buttonEl) {
        buttonEl.disabled = true;
        buttonEl.textContent = "Anchoring...";
      }

      // Send tx to Ganache
      // Gas limit is set to avoid estimateGas issues on some Ganache setups
      const tx = await contract.logAudit(logHash, actionType, { gasLimit: 200000 });
      const receipt = await tx.wait();

      const txHash = receipt.transactionHash;

      // Save txHash back to MongoDB
      const res = await fetch(`/api/audit/${auditLogId}/tx`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ txHash })
      });

      if (!res.ok) {
        const msg = await res.text();
        alert("Saved on-chain but failed to update DB: " + msg);
        return;
      }

      // Reload to show “Anchored ✅”
      window.location.reload();
    }

    // Attach button listeners
    document.querySelectorAll(".anchor-btn").forEach(btn => {
      btn.addEventListener("click", async () => {
        try {
          await anchorLog(btn.dataset.id, btn.dataset.hash, btn.dataset.action, btn);
        } catch (err) {
          console.error(err);
          alert(err?.message || String(err));
          btn.disabled = false;
          btn.textContent = "Anchor to Ganache";
        }
      });
    });

    // Excel export (your existing logic)
    document.getElementById("exportExcel").addEventListener("click", () => {
      const table = document.querySelector("table");
      const ws = XLSX.utils.table_to_sheet(table);
      const range = XLSX.utils.decode_range(ws["!ref"]);

      for (let R = range.s.r + 1; R <= range.e.r; ++R) {
        const cellRef = XLSX.utils.encode_cell({ r: R, c: 0 });
        const cell = ws[cellRef];
        if (cell?.v) {
          const dateObj = new Date(cell.v);
          if (!isNaN(dateObj.getTime())) {
            cell.v = dateObj;
            cell.t = "d";
            cell.z = "yyyy-mm-dd hh:mm:ss";
          }
        }
      }

      const wb = XLSX.utils.book_new();
      XLSX.utils.book_append_sheet(wb, ws, "Audit Logs");
      XLSX.writeFile(wb, "audit_logs.xlsx");
    });
  </script>

</body>
</html>
