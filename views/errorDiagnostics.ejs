<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Error Diagnostics • Ops</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <%- include("partials/navbar") %>
  <div class="sidebar-hover-zone"></div>
  <%- include("partials/sidebar") %>

  <div class="container py-4">
    <h1 class="mb-3">Error Diagnostics</h1>
    <p class="text-muted mb-4">
      Latest server errors logged for troubleshooting. Only visible to Operations team.
    </p>

    <div class="table-responsive">
      <table class="table table-sm table-striped align-middle">
        <thead class="table-dark">
          <tr>
            <th>Time</th>
            <th>Status</th>
            <th>Route</th>
            <th>Method</th>
            <th>Error Message</th>
            <th>User</th>
          </tr>
        </thead>
        <tbody>
          <% if (!logs || logs.length === 0) { %>
            <tr>
              <td colspan="6" class="text-center text-muted py-4">
                No errors logged yet. 🎉
              </td>
            </tr>
          <% } else { %>
            <% logs.forEach(log => { %>
              <tr>
                <td><%= new Date(log.createdAt || log.timestamp).toLocaleString() %></td>
                <td>
                  <span class="badge bg-danger"><%= log.statusCode || 500 %></span>
                </td>
                <td><code><%= log.route || '-' %></code></td>
                <td><%= log.method || '-' %></td>
                <td style="max-width: 300px;">
                  <span title="<%= log.stack || '' %>">
                    <%= log.message %>
                  </span>
                </td>
                <td>
                  <% if (log.userEmail) { %>
                    <%= log.userEmail %> (<%= log.userRole || 'user' %>)
                  <% } else { %>
                    <span class="text-muted">Guest / N/A</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</body>
</html>
