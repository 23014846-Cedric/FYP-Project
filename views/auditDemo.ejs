<!DOCTYPE html>
<html>
<head>
  <title>WIP • Blockchain Audit Demo</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>

<body class="p-4">
  <%- include("partials/navbar") %>
  <div class="sidebar-hover-zone"></div>
  <%- include("partials/sidebar") %>

  <div class="container mt-4">
    <h1 class="mb-3">Blockchain Audit Log Demo</h1>
    <p class="text-muted">MongoDB log → SHA-256 hash → MetaMask tx → save txHash back to MongoDB</p>

    <div class="card mt-3">
      <div class="card-body">
        <button id="btn-demo" class="btn btn-primary">Run Blockchain Audit Demo</button>
        <div id="status" class="mt-3 small text-muted"></div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/ethers@5.7.2/dist/ethers.umd.min.js"></script>

  <script>
    const CONTRACT_ADDRESS = "0xF9cC401278b0Cd6a1Ebe54282B0015b0cA0aF7D1";

    const CONTRACT_ABI = [
    {
        "anonymous": false,
        "inputs": [
        { "indexed": true, "internalType": "address", "name": "user", "type": "address" },
        { "indexed": true, "internalType": "bytes32", "name": "logHash", "type": "bytes32" },
        { "indexed": false, "internalType": "string", "name": "actionType", "type": "string" },
        { "indexed": false, "internalType": "uint256", "name": "timestamp", "type": "uint256" }
        ],
        "name": "AuditLogged",
        "type": "event"
    },
    {
        "inputs": [
        { "internalType": "bytes32", "name": "logHash", "type": "bytes32" },
        { "internalType": "string", "name": "actionType", "type": "string" }
        ],
        "name": "logAudit",
        "outputs": [],
        "stateMutability": "nonpayable",
        "type": "function"
    }
    ];


    const statusEl = document.getElementById("status");
    const btn = document.getElementById("btn-demo");

    const setStatus = (m) => { statusEl.textContent = m; console.log(m); };

    btn.addEventListener("click", async () => {
      try {
        if (!window.ethereum) return setStatus("MetaMask not detected.");

        setStatus("1) Creating sample audit log...");
        const res = await fetch("/api/audit/sample", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ actionType: "DEMO_ACTION" })
        });

        const data = await res.json();
        if (!res.ok) return setStatus("Backend error: " + (data.error || "Unknown"));

        const { auditLogId, logHash, actionType } = data;
        setStatus("2) Got logHash: " + logHash + " → opening MetaMask...");

        const provider = new ethers.providers.Web3Provider(window.ethereum);
        await provider.send("eth_requestAccounts", []);

        const signer = provider.getSigner();
        const contract = new ethers.Contract(CONTRACT_ADDRESS, CONTRACT_ABI, signer);

        setStatus("3) Sending blockchain tx...");
        const tx = await contract.logAudit(logHash, actionType);
        setStatus("Tx submitted: " + tx.hash + " (waiting confirm)");

        const receipt = await tx.wait();
        const txHash = receipt.transactionHash;

        setStatus("4) Confirmed: " + txHash + " → saving txHash to DB...");
        await fetch("/api/audit/" + auditLogId + "/tx", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ txHash })
        });

        setStatus("✅ Done. txHash saved in MongoDB.");
      } catch (e) {
        setStatus("Error: " + (e.message || e));
      }
    });
  </script>
</body>
</html>
