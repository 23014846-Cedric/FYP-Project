<!DOCTYPE html>
<html>
<head>
  <title>Notifications</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<style>
  .bg-unread {
    background-color: #efcaca; /* slightly darker dusty red */
    border-left: 5px solid #b21f2d; /* deeper, less vibrant red */
  }
</style>



<body class="p-4">
  <%- include("partials/navbar") %>
  <div class="container">

    <div class="sidebar-hover-zone"></div>
    <%- include("partials/sidebar") %>

    <h3 class="mb-3">Notifications</h3>

    <form class="row g-2 align-items-end mb-3" method="GET" action="/notifications">
  <div class="col-auto">
    <label class="form-label mb-0">Category</label>
    <select class="form-select form-select-sm" name="category">
      <option value="all" <%= (filters?.category==='all')?'selected':'' %>>All</option>
      <option value="EXCEPTION_ALERT" <%= (filters?.category==='EXCEPTION_ALERT')?'selected':'' %>>Exception</option>
      <option value="PROCESS_ALERT" <%= (filters?.category==='PROCESS_ALERT')?'selected':'' %>>Process</option>
      <option value="RISK_OVERSIGHT" <%= (filters?.category==='RISK_OVERSIGHT')?'selected':'' %>>Risk</option>
    </select>
  </div>

  <div class="col-auto">
    <label class="form-label mb-0">Severity</label>
    <select class="form-select form-select-sm" name="severity">
      <option value="all" <%= (filters?.severity==='all')?'selected':'' %>>All</option>
      <option value="info" <%= (filters?.severity==='info')?'selected':'' %>>Info</option>
      <option value="warning" <%= (filters?.severity==='warning')?'selected':'' %>>Warning</option>
      <option value="critical" <%= (filters?.severity==='critical')?'selected':'' %>>Critical</option>
    </select>
  </div>

  <div class="col-auto">
    <label class="form-label mb-0">Read</label>
    <select class="form-select form-select-sm" name="read">
    <option value="all" <%= (filters?.read==='all' || !filters?.read) ? 'selected' : '' %>>All</option>
    <option value="unread" <%= (filters?.read==='unread') ? 'selected' : '' %>>Unread</option>
    <option value="read" <%= (filters?.read==='read') ? 'selected' : '' %>>Read</option>
</select>

  </div>

  <div class="col-auto">
    <button class="btn btn-sm btn-primary" type="submit">Filter</button>
  </div>
  </form>

  <div class="col-auto ms-auto">
    <form method="POST" action="/notifications/read-all">
      <button class="btn btn-sm btn-outline-success" type="submit">
        Mark all as read
      </button>
    </form>
  </div>
</form>


    <% (notifications || []).forEach(n => { %>
      <div class="border rounded p-3 mb-2 <%= n.is_read ? '' : 'bg-unread'  %>">
        <div class="d-flex justify-content-between">
          <div>
            <strong><%= n.title %></strong>
            <span class="badge bg-secondary ms-2"><%= n.category %></span>
            <span class="badge <%= n.severity==='critical'?'bg-danger': n.severity==='warning'?'bg-warning text-dark':'bg-info' %> ms-1">
              <%= n.severity %>
            </span>
          </div>
          <small class="text-muted"><%= new Date(n.createdAt).toLocaleString("en-SG") %></small>
        </div>

        <div class="mt-2"><%= n.message %></div>

        <% if (n.data && n.data.reasons && n.data.reasons.length) { %>
          <ul class="mt-2">
            <% n.data.reasons.forEach(r => { %><li><%= r %></li><% }) %>
          </ul>
        <% } %>

        <% if (n.link_url) { %>
          <a class="btn btn-sm btn-outline-primary mt-2" href="<%= n.link_url %>">Open</a>
        <% } %>

        <form method="POST" action="/notifications/<%= n._id %>/read" class="d-inline">
          <button class="btn btn-sm btn-outline-success mt-2">Mark read</button>
        </form>

        <form method="POST" action="/notifications/<%= n._id %>/delete" class="d-inline">
          <button class="btn btn-sm btn-outline-danger mt-2">Delete</button>
        </form>
      </div>
    <% }) %>
  </div>
</body>
</html>
