<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Error</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <div class="container py-5">
    <div class="card shadow-sm">
      <div class="card-body">
        <h1 class="h4 text-danger mb-3">Access Denied</h1>

        <p class="mb-4">
          <%= message || "You do not have permission to view this page." %>
        </p>

        <a href="/" class="btn btn-primary">Back to Home</a>
        <a href="/dashboard" class="btn btn-outline-secondary ms-2">Go to Dashboard</a>
      </div>
    </div>
  </div>
</body>
</html>
